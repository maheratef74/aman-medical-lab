@model DrMohamedWeb.ViewModels.DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "لوحة التحكم";
}

<style>
    .dash-header {
        background: linear-gradient(135deg, #7f1d1d 0%, #d5212a 55%, #b91d31 100%);
        color: #fff;
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 28px;
        box-shadow: 0 12px 30px rgba(213, 33, 42, .25);
        position: relative;
        overflow: hidden;
    }
    .dash-header::after {
        content: '';
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .08);
        top: -100px;
        left: -60px;
    }
    .dash-header::before {
        content: '';
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(25, 135, 84, .35);
        bottom: -80px;
        right: 12%;
    }
    .dash-header h2 { font-weight: 800; margin-bottom: 6px; position: relative; z-index: 1; }
    .dash-header p { margin: 0; opacity: .9; position: relative; z-index: 1; }

    .stat-card {
        background: #fff;
        border-radius: 18px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
        border: 1px solid #eef2f5;
        position: relative;
        overflow: hidden;
        height: 100%;
        transition: transform .25s, box-shadow .25s;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, .12);
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 6px;
        height: 100%;
    }
    .stat-card.red::before { background: #d5212a; }
    .stat-card.green::before { background: #198754; }
    .stat-card.amber::before { background: #d97706; }
    .stat-card.slate::before { background: #334155; }

    .stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        color: #fff;
    }
    .stat-icon.red { background: linear-gradient(135deg, #d5212a, #7f1d1d); box-shadow: 0 6px 14px rgba(213, 33, 42, .3); }
    .stat-icon.green { background: linear-gradient(135deg, #198754, #14532d); box-shadow: 0 6px 14px rgba(25, 135, 84, .3); }
    .stat-icon.amber { background: linear-gradient(135deg, #f59e0b, #b45309); box-shadow: 0 6px 14px rgba(245, 158, 11, .3); }
    .stat-icon.slate { background: linear-gradient(135deg, #64748b, #334155); box-shadow: 0 6px 14px rgba(51, 65, 85, .3); }

    .stat-value { font-size: 1.75rem; font-weight: 800; color: #0f172a; line-height: 1.1; }
    .stat-label { font-size: .85rem; color: #64748b; font-weight: 600; margin-top: 2px; }
    .stat-trend {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 50px;
        margin-top: 6px;
    }
    .stat-trend.up { background: rgba(25, 135, 84, .1); color: #198754; }
    .stat-trend.down { background: rgba(213, 33, 42, .1); color: #d5212a; }
    .stat-trend.flat { background: rgba(100, 116, 139, .1); color: #64748b; }

    .chart-card {
        background: #fff;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
        border: 1px solid #eef2f5;
        height: 100%;
    }
    .chart-card h5 {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 4px;
        font-size: 1.05rem;
    }
    .chart-card .chart-sub { color: #94a3b8; font-size: .8rem; font-weight: 600; margin-bottom: 16px; }
    .chart-wrap { position: relative; height: 300px; }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border-radius: 14px;
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        transition: all .25s;
        border: none;
        width: 100%;
        text-align: right;
    }
    .quick-action:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(15, 23, 42, .18); }
    .quick-action.red { background: linear-gradient(135deg, #d5212a, #b91d31); }
    .quick-action.green { background: linear-gradient(135deg, #198754, #14532d); }
    .quick-action.outline {
        background: #fff;
        color: #334155;
        border: 1.5px solid #e2e8f0;
    }
    .quick-action.outline:hover { color: #d5212a; border-color: #d5212a; background: #fff; }
    .quick-action .qa-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, .18);
        font-size: 1.1rem;
    }
    .quick-action.outline .qa-icon { background: rgba(213, 33, 42, .08); color: #d5212a; }
    .quick-action .qa-text { flex: 1; }
    .quick-action .qa-text small { display: block; font-weight: 500; opacity: .75; font-size: .72rem; }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        transition: background .2s;
    }
    .activity-item:hover { background: #f8fafc; }
    .activity-item + .activity-item { border-top: 1px solid #f1f5f9; }
    .avatar {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 1.05rem;
    }
    .avatar.red { background: linear-gradient(135deg, #d5212a, #7f1d1d); }
    .avatar.green { background: linear-gradient(135deg, #198754, #14532d); }
    .avatar.amber { background: linear-gradient(135deg, #f59e0b, #b45309); }
    .avatar.slate { background: linear-gradient(135deg, #64748b, #334155); }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 50px;
    }
    .chip-green { background: rgba(25, 135, 84, .1); color: #198754; }
    .chip-red { background: rgba(213, 33, 42, .1); color: #d5212a; }
    .chip-slate { background: rgba(100, 116, 139, .12); color: #64748b; }
</style>

<div class="dash-header">
    <h1><i class="fas fa-tachometer-alt me-2"></i>مرحباً بعودتك 👋</h1>
    <p>نظرة شاملة على نشاط معمل أمان — المرضى، الزيارات، والنتائج المرفوعة.</p>
</div>

<!-- ═══════════ KPI CARDS ═══════════ -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card red">
            <div class="stat-icon red"><i class="fas fa-users"></i></div>
            <div class="flex-grow-1">
                <div class="stat-value">@Model.TotalPatients</div>
                <div class="stat-label">إجمالي المرضى</div>
            </div>
            <div class="text-start">
                @{
                    var pDelta = Model.NewPatientsThisMonth - Model.NewPatientsLastMonth;
                    var pCls = pDelta > 0 ? "up" : (pDelta < 0 ? "down" : "flat");
                    var pArrow = pDelta > 0 ? "▲" : (pDelta < 0 ? "▼" : "•");
                }
                <span class="stat-trend @pCls">@pArrow @(pDelta > 0 ? "+" : "")@Model.NewPatientsThisMonth هذا الشهر</span>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card green">
            <div class="stat-icon green"><i class="fas fa-calendar-check"></i></div>
            <div class="flex-grow-1">
                <div class="stat-value">@Model.TotalVisits</div>
                <div class="stat-label">إجمالي الزيارات</div>
            </div>
            <div class="text-end">
                @{
                    var vDelta = Model.VisitsThisMonth - Model.VisitsLastMonth;
                    var vCls = vDelta > 0 ? "up" : (vDelta < 0 ? "down" : "flat");
                    var vArrow = vDelta > 0 ? "▲" : (vDelta < 0 ? "▼" : "•");
                }
                <span class="stat-trend @vCls">@vArrow @(vDelta > 0 ? "+" : "")@Model.VisitsThisMonth هذا الشهر</span>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card amber">
            <div class="stat-icon amber"><i class="fas fa-file-pdf"></i></div>
            <div class="flex-grow-1">
                <div class="stat-value">@Model.TotalTestResults</div>
                <div class="stat-label">ملفات النتائج المرفوعة</div>
            </div>
            <div class="text-trend">
                <span class="stat-trend flat">● PDF</span>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card slate">
            <div class="stat-icon slate"><i class="fas fa-eye"></i></div>
            <div class="flex-grow-1">
                <div class="stat-value">@Model.AvailableVisits</div>
                <div class="stat-label">زيارات متاحة للمريض</div>
            </div>
            <div class="text-trend">
                <span class="stat-trend flat">@Model.HiddenVisits مخفية</span>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ CHARTS ═══════════ -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <h5><i class="fas fa-chart-bar me-2 text-danger"></i>المرضى الجدد والزيارات شهرياً</h5>
            <div class="chart-sub">آخر 6 أشهر</div>
            <div class="chart-wrap"><canvas id="patientsVisitsChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <h5><i class="fas fa-chart-pie me-2 text-success"></i>حالة الزيارات</h5>
            <div class="chart-sub">متاحة للمريض أم مخفية</div>
            <div class="chart-wrap"><canvas id="availabilityChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <h5><i class="fas fa-file-medical me-2 text-warning"></i>ملفات النتائج المرفوعة شهرياً</h5>
            <div class="chart-sub">آخر 6 أشهر</div>
            <div class="chart-wrap"><canvas id="resultsChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card d-flex flex-column">
            <h5><i class="fas fa-bolt me-2 text-danger"></i>إجراءات سريعة</h5>
            <div class="chart-sub">أكمل المهام في خطوة واحدة</div>
            <div class="d-flex flex-column gap-3 flex-grow-1">
                <a asp-controller="Visits" asp-action="AddVisit" class="quick-action red">
                    <span class="qa-icon"><i class="fas fa-wand-magic-sparkles"></i></span>
                    <span class="qa-text">مريض + زيارة + نتائج<small>معالج من 3 خطوات سريعة</small></span>
                    <i class="fas fa-arrow-left"></i>
                </a>
                <a asp-controller="Patients" asp-action="Create" class="quick-action green">
                    <span class="qa-icon"><i class="fas fa-user-plus"></i></span>
                    <span class="qa-text">إضافة مريض فقط<small>تسجيل مريض جديد بسرعة</small></span>
                    <i class="fas fa-arrow-left"></i>
                </a>
                <a asp-controller="Patients" asp-action="Index" class="quick-action outline">
                    <span class="qa-icon"><i class="fas fa-users-gear"></i></span>
                    <span class="qa-text">إدارة المرضى<small>عرض وبحث في قائمة المرضى</small></span>
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ RECENT ACTIVITY ═══════════ -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="chart-card">
            <h5><i class="fas fa-history me-2 text-primary"></i>أحدث الزيارات</h5>
            <div class="chart-sub">آخر 5 زيارات مسجلة</div>
            @if (Model.RecentVisits.Any())
            {
                foreach (var item in Model.RecentVisits)
                {
                    <div class="activity-item">
                        <div class="avatar @(item.IsAvailable ? "green" : "slate")">
                            @(string.IsNullOrEmpty(item.PatientName) ? "?" : item.PatientName.Substring(0, 1))
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold" style="color:#0f172a;">@item.PatientName</div>
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt me-1"></i>@item.VisitDate.ToString("yyyy-MM-dd")
                                <i class="fas fa-file-pdf mx-1"></i>@item.FilesCount ملف
                            </small>
                        </div>
                        @if (item.IsAvailable)
                        {
                            <span class="chip chip-green"><i class="fas fa-eye me-1"></i>متاحة</span>
                        }
                        else
                        {
                            <span class="chip chip-slate"><i class="fas fa-eye-slash me-1"></i>مخفية</span>
                        }
                        <a asp-controller="Visits" asp-action="Index" asp-route-patientId="@item.PatientId" class="btn btn-sm btn-outline-danger rounded-pill">
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-3x d-block mb-3 opacity-50"></i>
                    لا توجد زيارات مسجلة بعد
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="chart-card">
            <h5><i class="fas fa-user-clock me-2 text-success"></i>أحدث المرضى</h5>
            <div class="chart-sub">آخر 5 مرضى مسجلين</div>
            @if (Model.RecentPatients.Any())
            {
                foreach (var item in Model.RecentPatients)
                {
                    <div class="activity-item">
                        <div class="avatar red">@(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1))</div>
                        <div class="flex-grow-1">
                            <div class="fw-bold" style="color:#0f172a;">@item.Name</div>
                            <small class="text-muted" dir="ltr" style="text-align:right; display:block;">@item.PhoneNumber</small>
                        </div>
                        <div class="text-end">
                            <span class="chip chip-slate">@item.VisitsCount زيارة</span>
                            <small class="d-block text-muted mt-1">@item.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-users-slash fa-3x d-block mb-3 opacity-50"></i>
                    لا يوجد مرضى مسجلين بعد
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = "'Cairo', 'Tajawal', sans-serif";
    Chart.defaults.font.size = 13;
    Chart.defaults.color = '#64748b';

    var monthLabels = @Html.Raw(Json.Serialize(Model.MonthLabels));
    var patientsPerMonth = @Html.Raw(Json.Serialize(Model.PatientsPerMonth));
    var visitsPerMonth = @Html.Raw(Json.Serialize(Model.VisitsPerMonth));
    var resultsPerMonth = @Html.Raw(Json.Serialize(Model.ResultsPerMonth));

    // Patients vs Visits (bar)
    new Chart(document.getElementById('patientsVisitsChart'), {
        type: 'bar',
        data: {
            labels: monthLabels,
            datasets: [
                {
                    label: 'المرضى الجدد',
                    data: patientsPerMonth,
                    backgroundColor: 'rgba(213, 33, 42, .75)',
                    hoverBackgroundColor: '#d5212a',
                    borderRadius: 8,
                    barPercentage: .65
                },
                {
                    label: 'الزيارات',
                    data: visitsPerMonth,
                    backgroundColor: 'rgba(25, 135, 84, .75)',
                    hoverBackgroundColor: '#198754',
                    borderRadius: 8,
                    barPercentage: .65
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top', labels: { usePointStyle: true, pointStyle: 'circle', padding: 18 } } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } },
                x: { grid: { display: false } }
            }
        }
    });

    // Availability (doughnut)
    new Chart(document.getElementById('availabilityChart'), {
        type: 'doughnut',
        data: {
            labels: ['متاحة للمريض', 'مخفية'],
            datasets: [{
                data: [@Model.AvailableVisits, @Model.HiddenVisits],
                backgroundColor: ['#198754', '#d5212a'],
                hoverOffset: 8,
                borderWidth: 3,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
                legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 16, font: { size: 13 } } }
            }
        }
    });

    // Results per month (line/area)
    new Chart(document.getElementById('resultsChart'), {
        type: 'line',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'ملفات النتائج',
                data: resultsPerMonth,
                borderColor: '#d97706',
                backgroundColor: 'rgba(217, 119, 6, .12)',
                fill: true,
                tension: .42,
                pointBackgroundColor: '#d97706',
                pointBorderColor: '#fff',
                pointRadius: 5,
                pointHoverRadius: 7,
                borderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } },
                x: { grid: { display: false } }
            }
        }
    });
</script>