@model DrMohamedWeb.ViewModels.DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "لوحة التحكم";
    ViewData["Breadcrumb"] = "معمل أمان / لوحة التحكم";
}

<!-- ═══════════════════════════════════════
     WELCOME HEADER
═══════════════════════════════════════ -->
<div class="mb-6">
    <h2 class="text-2xl font-extrabold text-slate-800">مرحباً بك 👋</h2>
    <p class="text-slate-500 text-sm mt-1">إليك ملخص نشاط المعمل — المرضى، الزيارات، والنتائج المرفوعة</p>
</div>

<!-- ═══════════════════════════════════════
     KPI CARDS
═══════════════════════════════════════ -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    @{
        var pDelta  = Model.NewPatientsThisMonth - Model.NewPatientsLastMonth;
        var pCls    = pDelta > 0 ? "text-green-600 bg-green-50" : (pDelta < 0 ? "text-red-600 bg-red-50" : "text-slate-500 bg-slate-100");
        var pArrow  = pDelta > 0 ? "trending-up" : (pDelta < 0 ? "trending-down" : "minus");

        var vDelta  = Model.VisitsThisMonth - Model.VisitsLastMonth;
        var vCls    = vDelta > 0 ? "text-green-600 bg-green-50" : (vDelta < 0 ? "text-red-600 bg-red-50" : "text-slate-500 bg-slate-100");
        var vArrow  = vDelta > 0 ? "trending-up" : (vDelta < 0 ? "trending-down" : "minus");
    }

    <!-- إجمالي المرضى -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 flex items-start gap-4 hover:shadow-card-hover transition-shadow duration-200 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1.5 h-full bg-brand-600 rounded-r-2xl"></div>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-600 to-brand-900 flex items-center justify-center shadow-lg shadow-brand-600/25 shrink-0">
            <i data-lucide="users" class="w-5 h-5 text-white"></i>
        </div>
        <div class="flex-1 min-w-0">
            <div class="text-2xl font-extrabold text-slate-800 leading-none">@Model.TotalPatients</div>
            <div class="text-xs font-semibold text-slate-500 mt-1">إجمالي المرضى</div>
            <span class="inline-flex items-center gap-1 mt-2 text-xs font-bold px-2 py-0.5 rounded-full @pCls">
                <i data-lucide="@pArrow" class="w-3 h-3"></i>
                @(pDelta > 0 ? "+" : "")@Model.NewPatientsThisMonth هذا الشهر
            </span>
        </div>
    </div>

    <!-- إجمالي الزيارات -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 flex items-start gap-4 hover:shadow-card-hover transition-shadow duration-200 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1.5 h-full bg-green-600 rounded-r-2xl"></div>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-600 to-green-800 flex items-center justify-center shadow-lg shadow-green-600/25 shrink-0">
            <i data-lucide="calendar-check" class="w-5 h-5 text-white"></i>
        </div>
        <div class="flex-1 min-w-0">
            <div class="text-2xl font-extrabold text-slate-800 leading-none">@Model.TotalVisits</div>
            <div class="text-xs font-semibold text-slate-500 mt-1">إجمالي الزيارات</div>
            <span class="inline-flex items-center gap-1 mt-2 text-xs font-bold px-2 py-0.5 rounded-full @vCls">
                <i data-lucide="@vArrow" class="w-3 h-3"></i>
                @(vDelta > 0 ? "+" : "")@Model.VisitsThisMonth هذا الشهر
            </span>
        </div>
    </div>

    <!-- ملفات النتائج -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 flex items-start gap-4 hover:shadow-card-hover transition-shadow duration-200 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1.5 h-full bg-amber-500 rounded-r-2xl"></div>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-lg shadow-amber-500/25 shrink-0">
            <i data-lucide="file-text" class="w-5 h-5 text-white"></i>
        </div>
        <div class="flex-1 min-w-0">
            <div class="text-2xl font-extrabold text-slate-800 leading-none">@Model.TotalTestResults</div>
            <div class="text-xs font-semibold text-slate-500 mt-1">النتائج المرفوعة</div>
            <span class="inline-flex items-center gap-1 mt-2 text-xs font-bold px-2 py-0.5 rounded-full text-amber-700 bg-amber-50">
                <i data-lucide="file" class="w-3 h-3"></i> ملفات PDF
            </span>
        </div>
    </div>

    <!-- زيارات متاحة -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 flex items-start gap-4 hover:shadow-card-hover transition-shadow duration-200 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1.5 h-full bg-slate-500 rounded-r-2xl"></div>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-500 to-slate-700 flex items-center justify-center shadow-lg shadow-slate-500/20 shrink-0">
            <i data-lucide="eye" class="w-5 h-5 text-white"></i>
        </div>
        <div class="flex-1 min-w-0">
            <div class="text-2xl font-extrabold text-slate-800 leading-none">@Model.AvailableVisits</div>
            <div class="text-xs font-semibold text-slate-500 mt-1">زيارات متاحة للمريض</div>
            <span class="inline-flex items-center gap-1 mt-2 text-xs font-bold px-2 py-0.5 rounded-full text-slate-500 bg-slate-100">
                <i data-lucide="eye-off" class="w-3 h-3"></i> @Model.HiddenVisits مخفية
            </span>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     CHARTS ROW
═══════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

    <!-- Main bar chart (2/3 width) -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-100 shadow-card p-5">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <div>
                <h3 class="font-extrabold text-slate-800 text-sm">المرضى الجدد والزيارات</h3>
                <p class="text-xs text-slate-400 mt-0.5" id="barChartSub">آخر 6 أشهر</p>
            </div>
            <div class="flex items-center gap-2">
                <!-- Legend -->
                <div class="flex items-center gap-3 text-xs font-semibold text-slate-500 ml-3">
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-brand-600 inline-block"></span>مرضى جدد</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-600 inline-block"></span>زيارات</span>
                </div>
                <!-- Time-range pill buttons (shared) -->
                <div class="flex rounded-xl border border-slate-200 overflow-hidden" id="rangeToggle">
                    <button onclick="switchRange('7d', this)"
                            class="range-btn px-3 py-1.5 text-xs font-bold text-slate-500 hover:bg-slate-50 transition-colors">
                        7 أيام
                    </button>
                    <button onclick="switchRange('30d', this)"
                            class="range-btn px-3 py-1.5 text-xs font-bold text-slate-500 border-x border-slate-200 hover:bg-slate-50 transition-colors">
                        30 يوم
                    </button>
                    <button onclick="switchRange('6m', this)"
                            class="range-btn px-3 py-1.5 text-xs font-bold bg-brand-600 text-white transition-colors active-range">
                        6 أشهر
                    </button>
                </div>
            </div>
        </div>
        <div class="relative h-56">
            <canvas id="patientsVisitsChart"></canvas>
        </div>
    </div>

    <!-- Doughnut chart (1/3 width) -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5">
        <div class="mb-4">
            <h3 class="font-extrabold text-slate-800 text-sm">حالة الزيارات</h3>
            <p class="text-xs text-slate-400 mt-0.5">متاحة للمريض أم مخفية</p>
        </div>
        <div class="relative h-44">
            <canvas id="availabilityChart"></canvas>
        </div>
        <div class="flex justify-center gap-4 mt-3 text-xs font-semibold">
            <span class="flex items-center gap-1.5 text-green-600"><span class="w-2.5 h-2.5 rounded-full bg-green-600 inline-block"></span>متاحة</span>
            <span class="flex items-center gap-1.5 text-slate-500"><span class="w-2.5 h-2.5 rounded-full bg-slate-400 inline-block"></span>مخفية</span>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     LINE CHART + QUICK ACTIONS
═══════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">

    <!-- Results line chart -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-100 shadow-card p-5">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <div>
                <h3 class="font-extrabold text-slate-800 text-sm">ملفات النتائج المرفوعة</h3>
                <p class="text-xs text-slate-400 mt-0.5" id="lineChartSub">آخر 6 أشهر</p>
            </div>
            <!-- Duplicate range toggle for the results chart (mirrors the shared state) -->
            <div class="flex rounded-xl border border-slate-200 overflow-hidden" id="rangeToggle2">
                <button onclick="switchRange('7d', this)"
                        class="range-btn2 px-3 py-1.5 text-xs font-bold text-slate-500 hover:bg-slate-50 transition-colors">
                    7 أيام
                </button>
                <button onclick="switchRange('30d', this)"
                        class="range-btn2 px-3 py-1.5 text-xs font-bold text-slate-500 border-x border-slate-200 hover:bg-slate-50 transition-colors">
                    30 يوم
                </button>
                <button onclick="switchRange('6m', this)"
                        class="range-btn2 px-3 py-1.5 text-xs font-bold bg-brand-600 text-white transition-colors active-range2">
                    6 أشهر
                </button>
            </div>
        </div>
        <div class="relative h-48">
            <canvas id="resultsChart"></canvas>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 flex flex-col">
        <div class="mb-4">
            <h3 class="font-extrabold text-slate-800 text-sm">إجراءات سريعة</h3>
            <p class="text-xs text-slate-400 mt-0.5">أكمل المهام في خطوة واحدة</p>
        </div>
        <div class="flex flex-col gap-3 flex-1">
            <a asp-controller="Visits" asp-action="AddVisit"
               class="flex items-center gap-3 px-4 py-3 rounded-xl bg-gradient-to-l from-brand-600 to-brand-800 text-white font-bold text-sm transition-all hover:shadow-lg hover:shadow-brand-600/30 hover:-translate-y-0.5 active:translate-y-0">
                <span class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center shrink-0">
                    <i data-lucide="flask-conical" class="w-4 h-4"></i>
                </span>
                <span class="flex-1">
                    مريض + زيارة + نتائج
                    <small class="block font-medium opacity-75 text-xs">معالج من 3 خطوات سريعة</small>
                </span>
                <i data-lucide="arrow-left" class="w-4 h-4 opacity-75"></i>
            </a>

            <a asp-controller="Patients" asp-action="Create"
               class="flex items-center gap-3 px-4 py-3 rounded-xl bg-gradient-to-l from-green-600 to-green-800 text-white font-bold text-sm transition-all hover:shadow-lg hover:shadow-green-600/25 hover:-translate-y-0.5 active:translate-y-0">
                <span class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center shrink-0">
                    <i data-lucide="user-plus" class="w-4 h-4"></i>
                </span>
                <span class="flex-1">
                    إضافة مريض فقط
                    <small class="block font-medium opacity-75 text-xs">تسجيل مريض جديد بسرعة</small>
                </span>
                <i data-lucide="arrow-left" class="w-4 h-4 opacity-75"></i>
            </a>

            <a asp-controller="Patients" asp-action="Index"
               class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-200 text-slate-700 font-bold text-sm transition-all hover:border-brand-200 hover:bg-brand-50 hover:text-brand-700 hover:-translate-y-0.5 active:translate-y-0">
                <span class="w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 shrink-0">
                    <i data-lucide="users" class="w-4 h-4"></i>
                </span>
                <span class="flex-1">
                    إدارة المرضى
                    <small class="block font-medium text-slate-400 text-xs">عرض وبحث في قائمة المرضى</small>
                </span>
                <i data-lucide="arrow-left" class="w-4 h-4 text-slate-400"></i>
            </a>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     RECENT TABLES ROW
═══════════════════════════════════════ -->
<div class="grid grid-cols-1 lg:grid-cols-7 gap-4">

    <!-- Recent Visits (wider) -->
    <div class="lg:col-span-4 bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h3 class="font-extrabold text-slate-800 text-sm">آخر الزيارات</h3>
                <p class="text-xs text-slate-400 mt-0.5">أحدث 5 زيارات مسجلة</p>
            </div>
            <a asp-controller="Patients" asp-action="Index" class="text-xs font-bold text-brand-600 hover:text-brand-800 flex items-center gap-1 transition-colors">
                عرض الكل <i data-lucide="arrow-left" class="w-3 h-3"></i>
            </a>
        </div>

        @if (Model.RecentVisits.Any())
        {
            <div class="divide-y divide-slate-50">
                @foreach (var item in Model.RecentVisits)
                {
                    <div class="flex items-center gap-4 px-5 py-3.5 hover:bg-slate-50/70 transition-colors">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center font-extrabold text-sm shrink-0 @(item.IsAvailable ? "bg-green-100 text-green-700" : "bg-slate-100 text-slate-500")">
                            @(string.IsNullOrEmpty(item.PatientName) ? "؟" : item.PatientName.Substring(0, 1))
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-bold text-slate-800 truncate">@item.PatientName</div>
                            <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
                                <i data-lucide="calendar" class="w-3 h-3"></i>
                                <span>@item.VisitDate.ToString("yyyy-MM-dd")</span>
                                <span class="text-slate-300">·</span>
                                <i data-lucide="file" class="w-3 h-3"></i>
                                <span>@item.FilesCount ملف</span>
                            </div>
                        </div>
                        @if (item.IsAvailable)
                        {
                            <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-1 rounded-full bg-green-50 text-green-700">
                                <i data-lucide="eye" class="w-3 h-3"></i> متاحة
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-1 rounded-full bg-slate-100 text-slate-500">
                                <i data-lucide="eye-off" class="w-3 h-3"></i> مخفية
                            </span>
                        }
                        <a asp-controller="Visits" asp-action="Index" asp-route-patientId="@item.PatientId"
                           class="p-1.5 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-brand-50 transition-colors">
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                <i data-lucide="inbox" class="w-10 h-10 opacity-30 mb-3"></i>
                <p class="text-sm font-semibold">لا توجد زيارات مسجلة بعد</p>
            </div>
        }
    </div>

    <!-- Recent Patients (narrower) -->
    <div class="lg:col-span-3 bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h3 class="font-extrabold text-slate-800 text-sm">آخر المرضى</h3>
                <p class="text-xs text-slate-400 mt-0.5">أحدث 5 مرضى مسجلين</p>
            </div>
            <a asp-controller="Patients" asp-action="Create" class="text-xs font-bold text-brand-600 hover:text-brand-800 flex items-center gap-1 transition-colors">
                إضافة <i data-lucide="plus" class="w-3 h-3"></i>
            </a>
        </div>

        @if (Model.RecentPatients.Any())
        {
            <div class="divide-y divide-slate-50">
                @foreach (var item in Model.RecentPatients)
                {
                    <div class="flex items-center gap-3 px-5 py-3.5 hover:bg-slate-50/70 transition-colors">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center font-extrabold text-sm text-brand-700 shrink-0">
                            @(string.IsNullOrEmpty(item.Name) ? "؟" : item.Name.Substring(0, 1))
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-bold text-slate-800 truncate">@item.Name</div>
                            @{
                                var phone = item.PhoneNumber ?? "";
                                var waPhone = phone.StartsWith("0") ? "20" + phone.Substring(1) : (phone.StartsWith("20") ? phone : "20" + phone);
                            }
                            <div class="text-xs text-slate-400 mt-0.5 dir-ltr text-right">
                                <a href="https://wa.me/@waPhone" target="_blank" class="text-green-600 hover:text-green-800 font-semibold hover:underline inline-flex items-center gap-1 font-mono">
                                    <i data-lucide="message-square" class="w-3 h-3"></i>
                                    @item.PhoneNumber
                                </a>
                            </div>
                        </div>
                        <div class="text-end shrink-0">
                            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">@item.VisitsCount زيارة</span>
                            <div class="text-xs text-slate-400 mt-1">@item.CreatedAt.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-12 text-slate-400">
                <i data-lucide="users" class="w-10 h-10 opacity-30 mb-3"></i>
                <p class="text-sm font-semibold">لا يوجد مرضى مسجلين بعد</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = "'Cairo', sans-serif";
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = '#64748b';

    // ── All time-range datasets from server ──
    var datasets = {
        '7d': {
            labels:   @Html.Raw(Json.Serialize(Model.Labels7Days)),
            patients: @Html.Raw(Json.Serialize(Model.Patients7Days)),
            visits:   @Html.Raw(Json.Serialize(Model.Visits7Days)),
            results:  @Html.Raw(Json.Serialize(Model.Results7Days)),
            barSub:   'آخر 7 أيام',
            lineSub:  'آخر 7 أيام',
        },
        '30d': {
            labels:   @Html.Raw(Json.Serialize(Model.Labels30Days)),
            patients: @Html.Raw(Json.Serialize(Model.Patients30Days)),
            visits:   @Html.Raw(Json.Serialize(Model.Visits30Days)),
            results:  @Html.Raw(Json.Serialize(Model.Results30Days)),
            barSub:   'آخر 30 يوماً (أسبوعياً)',
            lineSub:  'آخر 30 يوماً (أسبوعياً)',
        },
        '6m': {
            labels:   @Html.Raw(Json.Serialize(Model.MonthLabels)),
            patients: @Html.Raw(Json.Serialize(Model.PatientsPerMonth)),
            visits:   @Html.Raw(Json.Serialize(Model.VisitsPerMonth)),
            results:  @Html.Raw(Json.Serialize(Model.ResultsPerMonth)),
            barSub:   'آخر 6 أشهر',
            lineSub:  'آخر 6 أشهر',
        },
    };

    var currentRange = '6m';

    /* ── Bar chart: patients + visits ── */
    var barChart = new Chart(document.getElementById('patientsVisitsChart'), {
        type: 'bar',
        data: {
            labels: datasets['6m'].labels,
            datasets: [
                {
                    label: 'المرضى الجدد',
                    data: datasets['6m'].patients,
                    backgroundColor: 'rgba(192,21,43,.80)',
                    hoverBackgroundColor: '#b91c2c',
                    borderRadius: 6,
                    barPercentage: .6,
                },
                {
                    label: 'الزيارات',
                    data: datasets['6m'].visits,
                    backgroundColor: 'rgba(22,163,74,.75)',
                    hoverBackgroundColor: '#15803d',
                    borderRadius: 6,
                    barPercentage: .6,
                },
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 400 },
            plugins: {
                legend: { display: false },
                tooltip: { rtl: true, bodyFont: { family: 'Cairo' } }
            },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' }, border: { dash: [4,4] } },
                x: { grid: { display: false } }
            }
        }
    });

    /* ── Doughnut: availability ── */
    new Chart(document.getElementById('availabilityChart'), {
        type: 'doughnut',
        data: {
            labels: ['متاحة للمريض', 'مخفية'],
            datasets: [{
                data: [@Model.AvailableVisits, @Model.HiddenVisits],
                backgroundColor: ['#16a34a', '#94a3b8'],
                hoverOffset: 6,
                borderWidth: 3,
                borderColor: '#fff',
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: { legend: { display: false }, tooltip: { rtl: true } }
        }
    });

    /* ── Area chart: results ── */
    var lineChart = new Chart(document.getElementById('resultsChart'), {
        type: 'line',
        data: {
            labels: datasets['6m'].labels,
            datasets: [{
                label: 'ملفات النتائج',
                data: datasets['6m'].results,
                borderColor: '#d97706',
                backgroundColor: 'rgba(217,119,6,.10)',
                fill: true,
                tension: .45,
                pointBackgroundColor: '#d97706',
                pointBorderColor: '#fff',
                pointRadius: 4,
                pointHoverRadius: 6,
                borderWidth: 2.5,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 400 },
            plugins: { legend: { display: false }, tooltip: { rtl: true } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' }, border: { dash: [4,4] } },
                x: { grid: { display: false } }
            }
        }
    });

    /* ── Range switcher ── */
    function switchRange(range, clickedBtn) {
        if (range === currentRange) return;
        currentRange = range;

        var d = datasets[range];

        // Update bar chart
        barChart.data.labels = d.labels;
        barChart.data.datasets[0].data = d.patients;
        barChart.data.datasets[1].data = d.visits;
        barChart.update();

        // Update line chart
        lineChart.data.labels = d.labels;
        lineChart.data.datasets[0].data = d.results;
        lineChart.update();

        // Update subtitles
        document.getElementById('barChartSub').textContent  = d.barSub;
        document.getElementById('lineChartSub').textContent = d.lineSub;

        // Sync both toggle groups
        ['range-btn', 'range-btn2'].forEach(function(cls) {
            document.querySelectorAll('.' + cls).forEach(function(btn) {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('text-slate-500');
            });
        });
        // Highlight matching button text in both groups
        document.querySelectorAll('.range-btn, .range-btn2').forEach(function(btn) {
            if (btn.textContent.trim() === clickedBtn.textContent.trim()) {
                btn.classList.add('bg-brand-600', 'text-white');
                btn.classList.remove('text-slate-500');
            }
        });
    }

    lucide.createIcons();
</script>
}