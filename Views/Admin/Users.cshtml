@model IEnumerable<DrMohamedWeb.Core.Entities.AdminUser>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "المستخدمون والحسابات";
    ViewData["Breadcrumb"] = "معمل أمان / المستخدمون";
}

<!-- ═══════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════ -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-800">المستخدمون والحسابات</h2>
        <p class="text-sm text-slate-500 mt-1">إنشاء وتحديث وإيقاف حسابات الدخول للوحة الإدارة</p>
    </div>
    <a asp-action="CreateUser"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        إضافة حساب
    </a>
</div>

<!-- ═══════════════════════════════════════
     ACCOUNTS TABLE
═══════════════════════════════════════ -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">

    @if (Model != null && Model.Any())
    {
        var count = Model.Count();
        <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500">
                @count @(count == 1 ? "حساب" : "حسابات") مسجلة
            </span>
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                <span class="text-xs text-slate-400 font-medium">محدّث الآن</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs font-bold text-slate-500 uppercase tracking-wide">
                        <th class="text-right px-5 py-3.5">#</th>
                        <th class="text-right px-5 py-3.5">الاسم</th>
                        <th class="text-right px-5 py-3.5">البريد الإلكتروني</th>
                        <th class="text-right px-5 py-3.5 hidden sm:table-cell">الدور</th>
                        <th class="text-right px-5 py-3.5">الحالة</th>
                        <th class="text-right px-5 py-3.5 hidden md:table-cell">آخر دخول</th>
                        <th class="text-center px-5 py-3.5">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @{
                        var currentEmail = User.Identity?.Name ?? "";
                        var i = 0;
                    }
                    @foreach (var item in Model)
                    {
                        i++;
                        var isSelf = string.Equals(item.Email, currentEmail, StringComparison.OrdinalIgnoreCase);
                        <tr class="hover:bg-slate-50/80 transition-colors group">
                            <td class="px-5 py-4 text-slate-400 font-semibold">@i</td>
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center font-extrabold text-sm text-brand-700 shrink-0">
                                        @(string.IsNullOrEmpty(item.FullName) ? "؟" : item.FullName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800 flex items-center gap-2">
                                            @(string.IsNullOrEmpty(item.FullName) ? item.Email : item.FullName)
                                            @if (isSelf)
                                            {
                                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-600 border border-blue-100">أنت</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4">
                                <span class="text-slate-600 font-semibold dir-ltr inline-block">@item.Email</span>
                            </td>
                            <td class="px-5 py-4 hidden sm:table-cell">
                                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                                    @switch (item.Role)
                                    {
                                        case "Admin":<text>مدير</text>break;
                                        case "Assistant":<text>مساعد</text>break;
                                        default:<text>موظف</text>break;
                                    }
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-1 rounded-full bg-green-50 text-green-700 border border-green-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                        نشط
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-1 rounded-full bg-red-50 text-red-700 border border-red-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                        موقوف
                                    </span>
                                }
                            </td>
                            <td class="px-5 py-4 hidden md:table-cell">
                                <span class="text-xs text-slate-500 font-medium">
                                    @(item.LastLoginAt.HasValue
                                        ? DrMohamedWeb.Application.Helpers.EgyptTime.Format(item.LastLoginAt)
                                        : "لم يسجل بعد")
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a asp-action="EditUser" asp-route-id="@item.Id" title="تعديل"
                                       class="p-2 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-brand-50 transition-colors">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>

                                    @if (isSelf)
                                    {
                                        <button type="button" disabled title="لا يمكنك إيقاف حسابك الحالي"
                                                class="p-2 rounded-lg text-slate-300 cursor-not-allowed">
                                            <i data-lucide="eye-off" class="w-4 h-4"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleUser" asp-route-id="@item.Id" method="post"
                                              class="inline toggle-form" data-action="@(item.IsActive ? "stop" : "activate")"
                                              data-name="@(string.IsNullOrEmpty(item.FullName) ? item.Email : item.FullName)"
                                              data-email="@item.Email">
                                            @Html.AntiForgeryToken()
                                            @if (item.IsActive)
                                            {
                                                <button type="button" class="toggle-btn p-2 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="إيقاف الحساب">
                                                    <i data-lucide="pause" class="w-4 h-4"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="toggle-btn p-2 rounded-lg text-slate-400 hover:text-green-600 hover:bg-green-50 transition-colors" title="تفعيل الحساب">
                                                    <i data-lucide="play" class="w-4 h-4"></i>
                                                </button>
                                            }
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center py-16 text-slate-400">
            <i data-lucide="users" class="w-10 h-10 opacity-30 mb-3"></i>
            <p class="text-sm font-semibold">لا توجد حسابات مسجلة بعد</p>
            <a asp-action="CreateUser" class="mt-3 text-sm font-bold text-brand-600 hover:text-brand-800 flex items-center gap-1 transition-colors">
                إضافة حساب <i data-lucide="arrow-left" class="w-3 h-3"></i>
            </a>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════
     TOGGLE CONFIRM MODAL
═══════════════════════════════════════ -->
<div id="toggleUserModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4"
     role="dialog" aria-modal="true">

    <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeToggleModal()"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden animate-modal">
        <div class="h-1.5 bg-gradient-to-l from-red-500 to-red-700" id="toggleAccent"></div>

        <div class="px-6 py-6 text-center">
            <div class="w-14 h-14 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4" id="toggleIconWrap">
                <i data-lucide="pause" class="w-7 h-7 text-red-600" id="toggleIcon"></i>
            </div>
            <h3 class="text-base font-extrabold text-slate-800 mb-2" id="toggleTitle">تأكيد إيقاف الحساب</h3>
            <p class="text-sm text-slate-500 mb-1" id="toggleSubtitle">هل أنت متأكد من إيقاف حساب</p>
            <p class="text-base font-extrabold text-slate-800 mb-3" id="toggleUserName">—</p>
            <p class="text-xs text-slate-400 mb-2" id="toggleEmail" dir="ltr">—</p>
            <p class="text-xs text-slate-400 mb-6" id="toggleHint"></p>

            <div class="flex gap-3">
                <button type="button" onclick="closeToggleModal()"
                        class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                    إلغاء
                </button>
                <button type="button" onclick="confirmToggle()" id="toggleConfirmBtn"
                        class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-red-600 text-white text-sm font-bold hover:bg-red-700 transition-colors shadow-lg shadow-red-600/20">
                    <i data-lucide="pause" class="w-4 h-4"></i>
                    نعم، أوقف
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    var toggleTargetForm = null;

    function openToggleModal(form) {
        toggleTargetForm = form;
        var action = form.getAttribute('data-action');
        var name   = form.getAttribute('data-name');
        var email  = form.getAttribute('data-email');
        var isStop = action === 'stop';

        document.getElementById('toggleTitle').textContent = isStop ? 'تأكيد إيقاف الحساب' : 'تأكيد تفعيل الحساب';
        document.getElementById('toggleSubtitle').textContent = isStop ? 'هل أنت متأكد من إيقاف حساب' : 'هل تريد إعادة تفعيل حساب';
        document.getElementById('toggleUserName').textContent = name;
        document.getElementById('toggleEmail').textContent = email;
        document.getElementById('toggleHint').textContent = isStop
            ? 'سيتم تسجيل خروجه فوراً ولن يتمكن من تسجيل الدخول حتى يتم تفعيله من جديد.'
            : 'سيتمكن هذا الحساب من تسجيل الدخول إلى لوحة الإدارة مباشرة.';

        document.getElementById('toggleAccent').className = 'h-1.5 bg-gradient-to-l ' + (isStop ? 'from-red-500 to-red-700' : 'from-green-500 to-green-700');

        var wrap = document.getElementById('toggleIconWrap');
        wrap.className = 'w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 ' + (isStop ? 'bg-red-50' : 'bg-green-50');
        document.getElementById('toggleIcon').className = 'w-7 h-7 ' + (isStop ? 'text-red-600' : 'text-green-600');

        var btn = document.getElementById('toggleConfirmBtn');
        btn.className = 'flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-white text-sm font-bold transition-colors shadow-lg ' +
            (isStop ? 'bg-red-600 hover:bg-red-700 shadow-red-600/20' : 'bg-green-600 hover:bg-green-700 shadow-green-600/20');
        btn.innerHTML = '<i data-lucide="' + (isStop ? 'pause' : 'play') + '" class="w-4 h-4"></i> ' + (isStop ? 'نعم، أوقف' : 'نعم، فعّل');

        lucide.createIcons();

        var modal = document.getElementById('toggleUserModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeToggleModal() {
        document.getElementById('toggleUserModal').classList.add('hidden');
        document.getElementById('toggleUserModal').classList.remove('flex');
        toggleTargetForm = null;
    }

    function confirmToggle() {
        if (toggleTargetForm) toggleTargetForm.submit();
    }

    document.querySelectorAll('.toggle-form').forEach(function (form) {
        var btn = form.querySelector('.toggle-btn');
        if (btn) {
            btn.addEventListener('click', function () {
                openToggleModal(form);
            });
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeToggleModal();
    });

    @if (TempData["Toast"] != null)
    {
        <text>window.showToast('@Html.Raw(TempData["Toast"]?.ToString()?.Replace("'", "\\'"))', 'success');</text>
    }
    @if (TempData["ToastError"] != null)
    {
        <text>window.showToast('@Html.Raw(TempData["ToastError"]?.ToString()?.Replace("'", "\\'"))', 'error');</text>
    }
</script>
}

<style>
    @@keyframes modalIn {
        from { opacity: 0; transform: scale(.96); }
        to   { opacity: 1; transform: scale(1); }
    }
    .animate-modal { animation: modalIn .2s ease-out; }
</style>