@model IEnumerable<DrMohamedWeb.Core.Entities.Patient>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "المرضى";
    ViewData["Breadcrumb"] = "معمل أمان / المرضى";
}

<!-- ═══════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════ -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-extrabold text-slate-800">المرضى</h2>
        <p class="text-sm text-slate-500 mt-1">إدارة ومتابعة بيانات المرضى المسجلين</p>
    </div>
    <button onclick="openModal('addPatientModal')"
       class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        إضافة مريض
    </button>
</div>

<!-- Toast alerts -->
@if (TempData["Success"] != null)
{
    <div id="toastMsg"
         class="flex items-center gap-3 px-4 py-3.5 mb-5 rounded-xl bg-green-50 border border-green-200 text-green-800">
        <i data-lucide="check-circle" class="w-5 h-5 text-green-600 shrink-0"></i>
        <span class="text-sm font-bold flex-1">@TempData["Success"]</span>
        <button onclick="document.getElementById('toastMsg').remove()"
                class="p-1 rounded-lg hover:bg-green-100 text-green-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toastErr"
         class="flex items-center gap-3 px-4 py-3.5 mb-5 rounded-xl bg-red-50 border border-red-200 text-red-800">
        <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0"></i>
        <span class="text-sm font-bold flex-1">@TempData["Error"]</span>
        <button onclick="document.getElementById('toastErr').remove()"
                class="p-1 rounded-lg hover:bg-red-100 text-red-600 transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>
}

<!-- ═══════════════════════════════════════
     SEARCH CARD
═══════════════════════════════════════ -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-card p-5 mb-6">
    <form asp-action="Index" method="get" id="searchForm" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <!-- Hidden input to reset page number to 1 on new searches -->
        <input type="hidden" name="page" value="1" />
        
        <div class="relative flex-1">
            <span class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-400">
                <i data-lucide="search" class="w-4 h-4"></i>
            </span>
            <input type="text"
                   name="searchQuery"
                   id="searchQueryInput"
                   value="@ViewBag.SearchQuery"
                   class="w-full pr-10 pl-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors font-semibold"
                   placeholder="بحث باسم المريض أو رقم الهاتف..."
                   autocomplete="off" />
        </div>
        <div class="flex items-center gap-2 shrink-0">
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
            {
                <a asp-action="Index"
                   class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-200 text-slate-600 text-sm font-semibold rounded-xl hover:bg-slate-50 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                    إلغاء البحث
                </a>
            }
        </div>
    </form>
</div>

<!-- ═══════════════════════════════════════
     PATIENTS TABLE
     ═══════════════════════════════════════ -->
<div id="patientsTableContainer" class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">

    @if (Model != null && Model.Any())
    {
        var count = Model.Count();
        <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500">
                @count @(count == 1 ? "مريض" : "مرضى") مسجلين
                @if (!string.IsNullOrEmpty(ViewBag.SearchPhone as string))
                {
                    <span class="text-brand-600"> · بحث عن "@ViewBag.SearchPhone"</span>
                }
            </span>
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
                <span class="text-xs text-slate-400 font-medium">محدّث الآن</span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs font-bold text-slate-500 uppercase tracking-wide">
                        <th class="text-right px-5 py-3.5">#</th>
                        <th class="text-right px-5 py-3.5">اسم المريض</th>
                        <th class="text-right px-5 py-3.5">رقم الهاتف</th>
                        <th class="text-right px-5 py-3.5 hidden sm:table-cell">تاريخ التسجيل</th>
                        <th class="text-center px-5 py-3.5">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors group" id="row-@item.Id">
                            <td class="px-5 py-4">
                                <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-lg">#@item.Id</span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center font-extrabold text-sm text-brand-700 shrink-0">
                                        @(string.IsNullOrEmpty(item.Name) ? "؟" : item.Name.Substring(0, 1))
                                    </div>
                                    <span class="font-bold text-slate-800 patient-name-display">@item.Name</span>
                                </div>
                            </td>
                            <td class="px-5 py-4">
                                @{
                                    var phone = item.PhoneNumber ?? "";
                                    var waPhone = phone.StartsWith("0") ? "20" + phone.Substring(1) : (phone.StartsWith("20") ? phone : "20" + phone);
                                }
                                <a href="https://wa.me/@waPhone" target="_blank" class="text-green-600 hover:text-green-800 font-bold hover:underline inline-flex items-center gap-1.5" title="مراسلة عبر واتساب">
                                    <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                                    <span class="patient-phone-display font-mono text-xs tracking-wider" dir="ltr">@item.PhoneNumber</span>
                                </a>
                            </td>
                            <td class="px-5 py-4 hidden sm:table-cell">
                                <span class="text-slate-500 text-xs">@item.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex items-center justify-center gap-1.5">
                                    <!-- Visits button -->
                                    <a asp-controller="Visits" asp-action="Index" asp-route-patientId="@item.Id"
                                       title="الزيارات والنتائج"
                                       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-brand-50 text-brand-700 text-xs font-bold hover:bg-brand-100 transition-colors">
                                        <i data-lucide="activity" class="w-3.5 h-3.5"></i>
                                        <span class="hidden sm:inline">الزيارات</span>
                                    </a>

                                    <!-- Edit button (opens inline modal) -->
                                    <button type="button"
                                            title="تعديل بيانات المريض"
                                            onclick="openEditModal(@item.Id, '@item.Name.Replace("'", "\\'")' , '@item.PhoneNumber')"
                                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-amber-50 text-amber-700 text-xs font-bold hover:bg-amber-100 transition-colors">
                                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                        <span class="hidden sm:inline">تعديل</span>
                                    </button>

                                    <!-- Delete button (opens confirm modal) -->
                                    <button type="button"
                                            title="حذف المريض"
                                            onclick="openDeleteModal(@item.Id, '@item.Name.Replace("'", "\\'")' )"
                                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-red-50 text-red-600 text-xs font-bold hover:bg-red-100 transition-colors">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        <span class="hidden sm:inline">حذف</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination controls -->
        @if (ViewBag.TotalPages > 1)
        {
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
            
            <div class="px-5 py-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-50/50">
                <span class="text-xs text-slate-500 font-semibold">
                    عرض الصفحة <strong class="text-slate-800">@currentPage</strong> من <strong class="text-slate-800">@totalPages</strong> (إجمالي <strong class="text-slate-800">@ViewBag.TotalItems</strong> مريض)
                </span>
                
                <div class="flex items-center gap-1">
                    <!-- Previous Page -->
                    @if (currentPage > 1)
                    {
                        <a asp-action="Index" asp-route-searchQuery="@ViewBag.SearchQuery" asp-route-page="@(currentPage - 1)" 
                           class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 pointer-events-none">
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </span>
                    }

                    <!-- Page Numbers -->
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white text-xs font-bold shadow-sm shadow-brand-600/20">@i</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-searchQuery="@ViewBag.SearchQuery" asp-route-page="@i" 
                               class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold transition-colors">@i</a>
                        }
                    }

                    <!-- Next Page -->
                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index" asp-route-searchQuery="@ViewBag.SearchQuery" asp-route-page="@(currentPage + 1)" 
                           class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </a>
                    }
                    else
                    {
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-100 bg-slate-50 text-slate-300 pointer-events-none">
                            <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        </span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
            {
                <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mb-4 text-slate-400">
                    <i data-lucide="search" class="w-7 h-7"></i>
                </div>
                <h4 class="font-bold text-slate-700 text-lg mb-1">لا توجد نتائج</h4>
                <p class="text-slate-400 text-sm mb-5">لم يتم العثور على مريض يطابق البحث: <span class="font-bold text-slate-600">"@ViewBag.SearchQuery"</span></p>
                <div class="flex gap-3">
                    <a asp-action="Index" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">إلغاء البحث</a>
                    <a asp-action="Create" class="px-4 py-2 rounded-xl bg-brand-600 text-white text-sm font-bold hover:bg-brand-700 transition-colors">إضافة مريض جديد</a>
                </div>
            }
            else
            {
                <div class="w-14 h-14 rounded-full bg-brand-50 flex items-center justify-center mb-4 text-brand-600">
                    <i data-lucide="users" class="w-7 h-7"></i>
                </div>
                <h4 class="font-bold text-slate-700 text-lg mb-1">لا يوجد مرضى مسجلين</h4>
                <p class="text-slate-400 text-sm mb-5">ابدأ بتسجيل أول مريض في النظام</p>
                <a asp-action="Create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold shadow-lg shadow-brand-600/25 hover:bg-brand-700 transition-all">
                    <i data-lucide="user-plus" class="w-4 h-4"></i>إضافة أول مريض
                </a>
            }
        </div>
    }
</div>

<!-- ═══════════════════════════════════════
     EDIT MODAL
═══════════════════════════════════════ -->
<div id="editModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4"
     role="dialog" aria-modal="true" aria-labelledby="editModalTitle">

    <!-- Backdrop -->
    <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeEditModal()"></div>

    <!-- Panel -->
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden animate-modal">

        <!-- Top accent -->
        <div class="h-1.5 bg-gradient-to-l from-amber-500 to-amber-600"></div>

        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600">
                    <i data-lucide="pencil" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-slate-800" id="editModalTitle">تعديل بيانات المريض</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="editModalSub">—</p>
                </div>
            </div>
            <button onclick="closeEditModal()"
                    class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="px-6 py-5">
            <input type="hidden" id="editPatientId" />

            <!-- Name field -->
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-1.5">
                    اسم المريض <span class="text-amber-600">*</span>
                </label>
                <input type="text" id="editName"
                       class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors"
                       placeholder="أدخل الاسم بالكامل" />
                <p class="text-xs text-red-500 font-semibold mt-1 hidden" id="editNameErr">هذا الحقل مطلوب</p>
            </div>

            <!-- Phone field -->
            <div class="mb-6">
                <label class="block text-sm font-bold text-slate-700 mb-1.5">
                    رقم الهاتف <span class="text-amber-600">*</span>
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-400">
                        <i data-lucide="phone" class="w-4 h-4"></i>
                    </span>
                    <input type="text" id="editPhone"
                           dir="ltr"
                           style="text-align:right"
                           class="w-full pr-10 pl-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors"
                           placeholder="01xxxxxxxxx"
                           maxlength="11" />
                </div>
                <p class="text-xs text-red-500 font-semibold mt-1 hidden" id="editPhoneErr">هذا الحقل مطلوب</p>
            </div>

            <!-- Response message -->
            <div id="editResponse" class="hidden flex items-center gap-2 p-3 rounded-xl text-sm font-bold mb-4"></div>

            <!-- Buttons -->
            <div class="flex gap-3">
                <button type="button" onclick="closeEditModal()"
                        class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                    إلغاء
                </button>
                <button type="button" id="saveEditBtn" onclick="saveEdit()"
                        class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 text-white text-sm font-bold hover:bg-amber-600 transition-colors shadow-lg shadow-amber-500/20">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    حفظ التعديلات
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     DELETE CONFIRM MODAL
═══════════════════════════════════════ -->
<div id="deleteModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4"
     role="dialog" aria-modal="true">

    <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeDeleteModal()"></div>

    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden animate-modal">
        <div class="h-1.5 bg-gradient-to-l from-red-500 to-red-700"></div>

        <div class="px-6 py-6 text-center">
            <div class="w-14 h-14 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                <i data-lucide="trash-2" class="w-7 h-7 text-red-600"></i>
            </div>
            <h3 class="text-base font-extrabold text-slate-800 mb-2">تأكيد حذف المريض</h3>
            <p class="text-sm text-slate-500 mb-1">هل أنت متأكد من حذف المريض</p>
            <p class="text-base font-extrabold text-red-600 mb-2" id="deletePatientNameDisplay">—</p>
            <p class="text-xs text-slate-400 mb-6">
                سيتم حذف <strong>جميع زياراته ونتائجه</strong> نهائياً ولا يمكن التراجع عن هذا الإجراء.
            </p>

            <form asp-action="Delete" method="post" id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deletePatientId" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeDeleteModal()"
                            class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        إلغاء
                    </button>
                    <button type="submit"
                            class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-red-600 text-white text-sm font-bold hover:bg-red-700 transition-colors shadow-lg shadow-red-600/20">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     ADD MODAL
═══════════════════════════════════════ -->
<div id="addPatientModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeModal('addPatientModal')"></div>
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md relative z-10 animate-modal overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <h3 class="font-extrabold text-slate-800 flex items-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-brand-600"></i>
                إضافة مريض جديد
            </h3>
            <button onclick="closeModal('addPatientModal')"
                    class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div class="p-5">
            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">اسم المريض <span class="text-red-500">*</span></label>
                    <input type="text" name="Name" required
                           class="w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:border-brand-500 focus:ring-1 focus:ring-brand-500 bg-slate-50 focus:bg-white transition-colors"
                           placeholder="أدخل الاسم الرباعي" />
                </div>
                <div class="mb-6">
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">رقم الهاتف <span class="text-red-500">*</span></label>
                    <input type="text" name="PhoneNumber" required
                           class="w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:border-brand-500 focus:ring-1 focus:ring-brand-500 bg-slate-50 focus:bg-white transition-colors text-left dir-ltr"
                           placeholder="مثال: 01xxxxxxxxx" />
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="closeModal('addPatientModal')"
                            class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        إلغاء
                    </button>
                    <button type="submit"
                            class="flex-1 px-4 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold hover:bg-brand-700 transition-colors shadow-lg shadow-brand-600/20">
                        إضافة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    // ── Modal helpers ──
    function openModal(id) {
        var el = document.getElementById(id);
        el.classList.remove('hidden');
        el.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        var el = document.getElementById(id);
        el.classList.add('hidden');
        el.classList.remove('flex');
        document.body.style.overflow = '';
    }

    // ── Edit Modal ──
    function openEditModal(id, name, phone) {
        document.getElementById('editPatientId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editPhone').value = phone;
        document.getElementById('editModalSub').textContent = 'المريض #' + id;
        document.getElementById('editNameErr').classList.add('hidden');
        document.getElementById('editPhoneErr').classList.add('hidden');
        document.getElementById('editResponse').classList.add('hidden');
        document.getElementById('editResponse').textContent = '';
        openModal('editModal');
        setTimeout(function() { document.getElementById('editName').focus(); }, 100);
    }
    function closeEditModal() { closeModal('editModal'); }

    function saveEdit() {
        var id    = parseInt(document.getElementById('editPatientId').value);
        var name  = document.getElementById('editName').value.trim();
        var phone = document.getElementById('editPhone').value.trim();
        var valid = true;

        if (!name)  { document.getElementById('editNameErr').classList.remove('hidden');  valid = false; }
        else         { document.getElementById('editNameErr').classList.add('hidden'); }
        if (!phone) { document.getElementById('editPhoneErr').classList.remove('hidden'); valid = false; }
        else         { document.getElementById('editPhoneErr').classList.add('hidden'); }

        if (!valid) return;

        var btn = document.getElementById('saveEditBtn');
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> جاري الحفظ…';

        fetch('@Url.Action("InlineEdit", "Patients")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id, name: name, phone: phone })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                // Update the row in-place without reload
                var row = document.getElementById('row-' + id);
                if (row) {
                    row.querySelector('.patient-name-display').textContent = name;
                    row.querySelector('.patient-phone-display').textContent = phone;
                }
                showInlineResponse('success', data.message || 'تم التعديل بنجاح');
                setTimeout(closeEditModal, 1200);
            } else {
                showInlineResponse('error', data.message || 'حدث خطأ');
                resetSaveBtn();
            }
        })
        .catch(function() {
            showInlineResponse('error', 'خطأ في الاتصال بالخادم');
            resetSaveBtn();
        });
    }

    function showInlineResponse(type, msg) {
        var el = document.getElementById('editResponse');
        el.classList.remove('hidden', 'bg-green-50', 'text-green-700', 'bg-red-50', 'text-red-700', 'border', 'border-green-200', 'border-red-200');
        if (type === 'success') {
            el.classList.add('flex', 'bg-green-50', 'text-green-700', 'border', 'border-green-200');
            el.innerHTML = '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> ' + msg;
        } else {
            el.classList.add('flex', 'bg-red-50', 'text-red-700', 'border', 'border-red-200');
            el.innerHTML = '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> ' + msg;
        }
    }

    function resetSaveBtn() {
        var btn = document.getElementById('saveEditBtn');
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg> حفظ التعديلات';
    }

    // ── Delete Modal ──
    function openDeleteModal(id, name) {
        document.getElementById('deletePatientId').value = id;
        document.getElementById('deletePatientNameDisplay').textContent = name;
        openModal('deleteModal');
    }
    function closeDeleteModal() { closeModal('deleteModal'); }

    // Close modals on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeEditModal();
            closeDeleteModal();
        }
    });

    // ── Instant Live Filter + Debounce ──
    document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('searchQueryInput');
        var typingTimer;
        var doneTypingInterval = 400; // 400ms

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                clearTimeout(typingTimer);
                
                // 1. Instantly filter current table rows
                var filter = searchInput.value.toLowerCase().trim();
                var rows = document.querySelectorAll('tbody tr[id^="row-"]');
                rows.forEach(function (row) {
                    var name = row.querySelector('.patient-name-display')?.textContent?.toLowerCase() || '';
                    var phone = row.querySelector('.patient-phone-display')?.textContent?.toLowerCase() || '';
                    if (name.includes(filter) || phone.includes(filter)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                // 2. Debounce to query the database globally via AJAX
                typingTimer = setTimeout(function () {
                    var query = searchInput.value.trim();
                    var url = '@Url.Action("Index", "Patients")?searchQuery=' + encodeURIComponent(query);
                    
                    fetch(url)
                        .then(function(res) { return res.text(); })
                        .then(function(html) {
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(html, 'text/html');
                            var newTable = doc.getElementById('patientsTableContainer');
                            if (newTable) {
                                document.getElementById('patientsTableContainer').innerHTML = newTable.innerHTML;
                                // Re-initialize lucide icons inside the new content
                                if (window.lucide) {
                                    window.lucide.createIcons();
                                }
                            }
                        })
                        .catch(function(err) {
                            console.error('Error fetching patients:', err);
                        });
                }, doneTypingInterval);
            });

            // Focus at cursor end
            searchInput.focus();
            var val = searchInput.value;
            searchInput.value = '';
            searchInput.value = val;
        }
    });

    // Auto-dismiss toast after 4s
    setTimeout(function() {
        ['toastMsg','toastErr'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.remove();
        });
    }, 4000);
</script>

<style>
    @@keyframes modalIn {
        from { opacity: 0; transform: scale(.95) translateY(8px); }
        to   { opacity: 1; transform: scale(1)  translateY(0); }
    }
    .animate-modal { animation: modalIn .2s ease-out; }
</style>
}
