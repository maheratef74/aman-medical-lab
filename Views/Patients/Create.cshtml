@model DrMohamedWeb.Core.Entities.Patient

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إضافة مريض جديد";
    ViewData["Breadcrumb"] = "معمل أمان / المرضى / إضافة مريض";
}

<!-- ═══════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════ -->
<div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-slate-400 mb-3">
        <a asp-action="Index" class="hover:text-brand-600 transition-colors">المرضى</a>
        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-semibold">إضافة مريض جديد</span>
    </div>
    <h2 class="text-2xl font-extrabold text-slate-800">إضافة مريض جديد</h2>
    <p class="text-sm text-slate-500 mt-1">أدخل بيانات المريض لتسجيله في النظام</p>
</div>

<!-- ═══════════════════════════════════════
     FORM CARD
═══════════════════════════════════════ -->
<div class="max-w-xl">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">

        <!-- Card header accent -->
        <div class="h-1.5 bg-gradient-to-l from-brand-600 to-brand-800"></div>

        <div class="p-6 sm:p-8">
            <!-- Validation summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="flex items-start gap-3 p-4 mb-6 rounded-xl bg-red-50 border border-red-200">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0 mt-0.5"></i>
                    <div>
                        <p class="text-sm font-bold text-red-700 mb-1">يوجد أخطاء في البيانات:</p>
                        <div asp-validation-summary="All" class="text-sm text-red-600 space-y-0.5"></div>
                    </div>
                </div>
            }

            <form asp-action="Create" method="post" id="createPatientForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Patient Name -->
                <div class="mb-5">
                    <label asp-for="Name" class="block text-sm font-bold text-slate-700 mb-1.5">
                        اسم المريض
                        <span class="text-brand-600 mr-0.5">*</span>
                    </label>
                    <input asp-for="Name"
                           class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 hover:border-slate-300 transition-colors"
                           placeholder="أدخل اسم المريض بالكامل"
                           required
                           autocomplete="name" />
                    <span asp-validation-for="Name" class="mt-1.5 text-xs font-semibold text-red-600"></span>
                </div>

                <!-- Phone Number -->
                <div class="mb-7">
                    <label asp-for="PhoneNumber" class="block text-sm font-bold text-slate-700 mb-1.5">
                        رقم الهاتف
                        <span class="text-brand-600 mr-0.5">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-slate-400">
                            <i data-lucide="phone" class="w-4 h-4"></i>
                        </span>
                        <input asp-for="PhoneNumber"
                               class="w-full pr-10 pl-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 hover:border-slate-300 transition-colors"
                               placeholder="01xxxxxxxxx"
                               dir="ltr"
                               style="text-align: right;"
                               required
                               maxlength="11"
                               autocomplete="tel" />
                    </div>
                    <p class="mt-1.5 text-xs text-slate-400 font-medium">
                        يُستخدم رقم الهاتف لاحقاً لعرض نتائج التحاليل
                    </p>
                    <span asp-validation-for="PhoneNumber" class="mt-1 flex items-center gap-1 text-xs font-semibold text-red-600"></span>
                </div>

                <!-- Buttons -->
                <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3">
                    <a asp-action="Index"
                       class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        إلغاء والعودة
                    </a>
                    <button type="submit"
                            id="submitBtn"
                            class="flex items-center justify-center gap-2 flex-1 sm:flex-initial px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        حفظ البيانات
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Helper tip -->
    <div class="mt-4 flex items-start gap-3 px-4 py-3 rounded-xl bg-blue-50 border border-blue-100">
        <i data-lucide="lightbulb" class="w-4 h-4 text-blue-500 shrink-0 mt-0.5"></i>
        <p class="text-xs font-semibold text-blue-700">
            بعد الحفظ، يمكنك إضافة زيارة ورفع نتائج التحاليل مباشرة من صفحة المريض أو عبر
            <a asp-controller="Visits" asp-action="AddVisit" class="underline hover:text-blue-900">إضافة زيارة ونتائج</a>.
        </p>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    document.getElementById('createPatientForm').addEventListener('submit', function(e) {
        const nameInput  = document.querySelector('[name="Name"]');
        const phoneInput = document.querySelector('[name="PhoneNumber"]');
        let isValid = true;

        // Simple client-side validation
        [nameInput, phoneInput].forEach(function(input) {
            if (!input.value.trim()) {
                input.classList.add('border-red-400', 'bg-red-50');
                input.classList.remove('border-slate-200', 'bg-slate-50');
                isValid = false;
            } else {
                input.classList.remove('border-red-400', 'bg-red-50');
                input.classList.add('border-green-400', 'bg-green-50/30');
            }
        });

        if (!isValid) {
            e.preventDefault();
            return;
        }

        // Loading state
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            جاري الحفظ…`;
    });

    // Real-time input feedback
    document.querySelectorAll('#createPatientForm input').forEach(function(input) {
        input.addEventListener('input', function() {
            if (this.value.trim()) {
                this.classList.remove('border-red-400', 'bg-red-50');
                this.classList.add('border-slate-200', 'bg-slate-50');
            }
        });
    });
</script>
}
