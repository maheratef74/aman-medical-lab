<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ══════════════════ PWA: Service Worker + Install Prompt ══════════════════
    (function () {
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (err) {
                    console.warn('SW registration failed:', err);
                });
            });
        }

        var installCard = document.getElementById('pwaInstallCard');
        if (!installCard) return;

        var installBtn = document.getElementById('pwaInstallBtn');
        var closeBtn = document.getElementById('pwaCloseBtn');
        var pwaDesc = document.getElementById('pwaDesc');
        var deferredPrompt = null;
        var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
        var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        var dismissed = sessionStorage.getItem('pwa_dismissed');

        // Already installed → never show the prompt
        if (isStandalone) return;

        function showCard(iOSMode) {
            if (dismissed) return;
            if (iOSMode) {
                installBtn.style.display = 'none';
                pwaDesc.textContent = 'اضغط زر المشاركة (Share) في المتصفح ثم اختر "إضافة إلى الشاشة الرئيسية".';
            }
            installCard.style.display = 'flex';
            requestAnimationFrame(function () {
                requestAnimationFrame(function () { installCard.style.opacity = '1'; });
            });
        }

        function hideCard() {
            installCard.style.opacity = '0';
            setTimeout(function () { installCard.style.display = 'none'; }, 250);
        }

        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            deferredPrompt = e;
            showCard(false);
        });

        window.addEventListener('appinstalled', function () {
            hideCard();
        });

        installBtn.addEventListener('click', function () {
            if (!deferredPrompt) return;
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(function (choice) {
                if (choice.outcome === 'accepted') {
                    hideCard();
                }
                deferredPrompt = null;
            });
        });

        closeBtn.addEventListener('click', function () {
            sessionStorage.setItem('pwa_dismissed', '1');
            dismissed = '1';
            hideCard();
        });

        // iOS has no beforeinstallprompt → show a hint after a short delay
        if (isIOS && !isStandalone) {
            setTimeout(function () { showCard(true); }, 2500);
        }
    })();
</script>
<script>
    // Navbar scroll effect
    (function() {
        const nav = document.getElementById('mainNav');
        const checkScroll = () => {
            if (window.scrollY > 40) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        };
        window.addEventListener('scroll', checkScroll);
        checkScroll();
    })();

    // Close mobile nav after link click
    document.querySelectorAll('#navMenu .nav-link').forEach(link => {
        link.addEventListener('click', () => {
            const collapse = document.getElementById('navMenu');
            const bsCollapse = bootstrap.Collapse.getInstance(collapse);
            if (bsCollapse) bsCollapse.hide();
        });
    });

    // Global modal reference
    var resultsModalObj = null;

    document.getElementById('searchForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const phone = document.getElementById('phoneInput').value.trim();
        
        if (!phone) return;
        
        localStorage.setItem('saved_search_phone', phone);
        
        const modalEl = document.getElementById('resultsModal');
        const modalBody = document.getElementById('modalResultsBody');
        
        // Lazy initialize the Bootstrap modal
        if (!resultsModalObj) {
            resultsModalObj = new bootstrap.Modal(modalEl);
        }
        
        // Show spinner inside modal
        modalBody.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">جاري البحث...</span>
                </div>
                <h5 class="mt-4 fw-bold text-slate-700">جاري البحث عن تحاليلك الطبية...</h5>
                <p class="text-muted small">مع أمان... صحتك دائماً في أمان</p>
            </div>
        `;
        resultsModalObj.show();

        fetch('@Url.Action("SearchByPhoneAjax", "Result")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({ phone: phone })
        })
        .then(response => {
            if (!response.ok && response.status !== 400 && response.status !== 404) {
                throw new Error('Network response was not ok');
            }
            return response.text();
        })
        .then(html => {
            modalBody.innerHTML = html;
        })
        .catch(error => {
            console.error('Error:', error);
            modalBody.innerHTML = '<div class="alert alert-danger text-center fw-bold rounded-4 p-4">حدث خطأ أثناء محاولة الاتصال بالخادم. يرجى المحاولة لاحقاً.</div>';
        });
    });

    document.addEventListener('click', function(e) {
        // Handle "عرض الزيارات السابقة" (Show All Visits)
        const allVisitsBtn = e.target.closest('#loadAllVisitsBtn');
        if (allVisitsBtn) {
            e.preventDefault();
            const phone = allVisitsBtn.getAttribute('data-phone');
            const modalBody = document.getElementById('modalResultsBody');
            
            modalBody.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="mt-3 text-muted fw-bold">جاري تحميل سجل الزيارات السابقة...</p>
                </div>
            `;
            
            fetch('@Url.Action("GetAllVisitsAjax", "Result")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ phone: phone })
            })
            .then(res => res.text())
            .then(html => modalBody.innerHTML = html)
            .catch(err => modalBody.innerHTML = '<div class="alert alert-danger text-center fw-bold rounded-4">حدث خطأ أثناء تحميل الزيارات السابقة.</div>');
        }

        // Handle "العودة لآخر تحليل" (Back to Latest Result)
        const latestResultBtn = e.target.closest('#loadLatestResultBtn');
        if (latestResultBtn) {
            e.preventDefault();
            const phone = latestResultBtn.getAttribute('data-phone');
            const modalBody = document.getElementById('modalResultsBody');
            
            modalBody.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="mt-3 text-muted fw-bold">جاري الرجوع لآخر تحليل...</p>
                </div>
            `;
            
            fetch('@Url.Action("SearchByPhoneAjax", "Result")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ phone: phone })
            })
            .then(res => res.text())
            .then(html => modalBody.innerHTML = html)
            .catch(err => modalBody.innerHTML = '<div class="alert alert-danger text-center fw-bold rounded-4">حدث خطأ أثناء الرجوع لآخر تحليل.</div>');
        }
    });

    // ==========================================
    // Home Visit Form Logic
    // ==========================================
    document.addEventListener('DOMContentLoaded', function () {
        const searchPhoneInput = document.getElementById('phoneInput');
        if (searchPhoneInput && localStorage.getItem('saved_search_phone')) {
            searchPhoneInput.value = localStorage.getItem('saved_search_phone');
        }

        const homeVisitForm = document.getElementById('homeVisitForm');
        if (!homeVisitForm) return;

        const nameInput = document.getElementById('userName');
        const phoneInput = document.getElementById('userPhone');
        const addressInput = document.getElementById('userAddress');
        const imageInput = document.getElementById('userImage');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const submitBtn = document.getElementById('submitVisitBtn');
        const successMsg = document.getElementById('successVisitMsg');
        let hasImage = false;

        if (localStorage.getItem('user_name')) nameInput.value = localStorage.getItem('user_name');
        if (localStorage.getItem('user_phone')) phoneInput.value = localStorage.getItem('user_phone');
        if (localStorage.getItem('user_address')) addressInput.value = localStorage.getItem('user_address');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    previewContainer.style.display = 'block';
                    document.querySelector('.file-upload-display div').textContent = file.name;
                }
                reader.readAsDataURL(file);
                hasImage = true;
            } else {
                previewContainer.style.display = 'none';
                document.querySelector('.file-upload-display div').textContent = 'اضغط هنا لاختيار صورة';
                hasImage = false;
            }
        });

        homeVisitForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            
            let isValid = true;
            [nameInput, phoneInput, addressInput].forEach(input => {
                if (!input.value.trim()) {
                    input.classList.add('is-invalid');
                    isValid = false;
                } else {
                    input.classList.remove('is-invalid');
                    input.classList.add('is-valid');
                }
            });

            if (!isValid) return;

            localStorage.setItem('user_name', nameInput.value.trim());
            localStorage.setItem('user_phone', phoneInput.value.trim());
            localStorage.setItem('user_address', addressInput.value.trim());

            submitBtn.disabled = true;
            submitBtn.style.display = 'none';
            successMsg.style.display = 'block';

            let uploadedImageUrl = '';

            if (hasImage && imageInput.files[0]) {
                const formData = new FormData();
                formData.append('image', imageInput.files[0]);

                try {
                    successMsg.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> جاري رفع الصورة...';
                    
                    const response = await fetch('/api/HomeVisit/UploadRequest', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        uploadedImageUrl = new URL(result.imageUrl, window.location.origin).href;
                    } else {
                        throw new Error(result.message || 'فشل في رفع الصورة');
                    }
                } catch (error) {
                    console.error('Upload Error:', error);
                    alert('حدث خطأ أثناء رفع الصورة. سيتم إرسال الطلب بدون المرفقات أو حاول مجدداً.');
                }
            }

            const name = nameInput.value.trim();
            const phone = phoneInput.value.trim();
            const address = addressInput.value.trim();
            
            let message = `طلب زيارة منزلية\n\nالاسم: ${name}\nرقم الهاتف: ${phone}\nالعنوان: ${address}`;
            
            if (uploadedImageUrl) {
                message += `\n\nصورة التحليل:\n${uploadedImageUrl}`;
            }

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/201143041240?text=${encodedMessage}`;

            successMsg.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> جاري تحويلك إلى واتساب...';

            setTimeout(() => {
                window.open(whatsappUrl, '_blank');
                
                setTimeout(() => {
                    submitBtn.disabled = false;
                    submitBtn.style.display = 'flex';
                    successMsg.style.display = 'none';
                    successMsg.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> جاري تحويلك إلى واتساب...';
                }, 3000);
            }, 800);
        });

        [nameInput, phoneInput, addressInput].forEach(input => {
            input.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
        });
    });
</script>
</body>
