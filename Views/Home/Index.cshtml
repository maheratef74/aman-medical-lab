@{
    ViewData["Title"] = "معمل أمان للتحاليل الطبية";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>معمل أمان للتحاليل الطبية</title>
    <meta name="description" content="معمل أمان للتحاليل الطبية – الدقة في النتائج والثقة في التشخيص." />

    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- External stylesheet -->
    <link rel="stylesheet" href="~/css/amanlab.css" />
    <!-- PWA -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#d5212a" />
    <link rel="apple-touch-icon" href="~/images/app-icon.jpeg" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="معمل أمان" />
