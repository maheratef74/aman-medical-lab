    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

</head>
<body>

<!-- ══════════════════ NAVBAR ══════════════════ -->
<nav id="mainNav" class="navbar navbar-expand-lg fixed-top py-2">
    <div class="container">
        <a class="navbar-brand navbar-brand-custom d-inline-flex align-items-center gap-2" href="#hero">
            <img src="~/images/aman-logo.png" alt="Logo" style="object-fit: contain;" />
            <span style="color:#000;">معمل</span> <span style="color:#d5212a;">أمان</span>
        </a>
        <button class="navbar-toggler border-0 shadow-none" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu"
                aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#hero">الرئيسية</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#about">عن المعمل</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#services">خدماتنا</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#howItWorks">كيفية الحصول على التحليل</a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#homeVisit">طلب زيارة منزلية <i class="bi bi-house-heart"></i></a></li>
                <li class="nav-item"><a class="nav-link nav-link-custom" href="#contact">تواصل معنا</a></li>
            </ul>
            <a href="https://wa.me/201143041240" target="_blank" class="btn btn-success btn-sm rounded-pill px-3 fw-bold text-white">
                <i class="bi bi-whatsapp me-1"></i> واتساب
            </a>
        </div>
    </div>
</nav>

<!-- ══════════════════ HERO ══════════════════ -->
<section id="hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div class="hero-badge"><i class="bi bi-shield-check me-1 text-success fs-5 align-middle"></i> معتمد ومرخّص رسمياً</div>
                <h1 class="hero-title mb-3">معمل أمان<br />للتحاليل الطبية</h1>
                <p class="hero-subtitle mb-2">الدقة في النتائج… الثقة في التشخيص</p>
                <div class="mb-4">
                    <span style="
                        display:inline-block;
                        background:rgba(255,255,255,0.18);
                        border:1px solid rgba(255,255,255,0.35);
                        color:#fff;
                        padding:.45rem 1.4rem;
                        border-radius:50px;
                        font-size:1rem;
                        font-weight:700;
                        letter-spacing:.03em;
                        backdrop-filter:blur(6px);
                    ">
                        ✦ مع أمان… نتائجك في أمان ✦
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-3 justify-content-center">
                    <a href="#searchSection" class="btn btn-light fw-bold rounded-pill px-4">
                        <i class="bi bi-search me-1"></i> عرض آخر تحليل
                    </a>
                    <a href="#services" class="btn btn-outline-light fw-bold rounded-pill px-4">
                        خدماتنا
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════ SEARCH (after hero) ══════════════════ -->
<section id="searchSection" class="py-5" style="background-color: #f8fafc; border-top: 1px solid #eef2f6; border-bottom: 1px solid #eef2f6;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <form id="searchForm" asp-controller="Result" asp-action="SearchByPhone" method="post" 
                      class="bg-white rounded-4 shadow-sm p-4 sm:p-5 border-0" style="text-align: right; border-radius: 24px !important; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05) !important;">
                    
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger mb-3" 
                             style="width: 56px; height: 56px; border-radius: 18px; font-size: 1.4rem; background-color: #fef2f2 !important; color: #d5212a !important;">
                            <i class="bi bi-search"></i>
                        </div>
                        <h4 class="fw-black text-slate-800 mb-1" style="font-size: 1.25rem;">عرض آخر نتيجة تحليل</h4>
                        <p class="text-muted small mb-0 fw-semibold">أدخل رقم الهاتف المسجل لدينا للاستعلام الفوري</p>
                    </div>

                    <div class="mb-4">
                        <label for="phoneInput" class="form-label fw-bold text-slate-600 small mb-2">رقم الهاتف المسجل</label>
                        <div class="input-group">
                            <span class="input-group-text bg-slate-50 border-end-0 text-slate-400" 
                                  style="border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-color: #e2e8f0; padding: 12px 16px;">
                                <i class="bi bi-phone"></i>
                            </span>
                            <input type="tel"
                                   name="phone"
                                   id="phoneInput"
                                   class="form-control text-center border-start-0 bg-slate-50"
                                   placeholder="01xxxxxxxxx"
                                   dir="ltr"
                                   maxlength="11" required 
                                   style="border-top-left-radius: 14px; border-bottom-left-radius: 14px; border-color: #e2e8f0; padding: 12px; font-weight: 700; color: #1e293b;" />
                        </div>
                    </div>

                    <button class="btn btn-danger w-100 py-3 fw-bold shadow-sm" type="submit" id="searchBtn" 
                            style="border-radius: 14px; background: linear-gradient(135deg, #d5212a, #b91c2c); border: none; font-size: 1rem; transition: transform 0.2s ease;">
                        <i class="bi bi-file-earmark-medical me-2"></i> استعلام عن النتيجة
                    </button>
                    
                    <div class="text-center mt-3 text-slate-400 small fw-bold" style="font-size: 0.78rem;">
                        <i class="bi bi-shield-fill-check text-success me-1"></i>بياناتك الطبية مشفرة ومحمية بالكامل
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════ RESULTS MODAL (Popup) ══════════════════ -->
<div class="modal fade" id="resultsModal" tabindex="-1" aria-labelledby="resultsModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden" style="border-radius: 20px !important;">
            <div class="modal-header border-0 pb-2 bg-white px-4 pt-4 flex items-center justify-between">
                <h5 class="modal-title fw-bold text-slate-800 d-flex align-items-center gap-2" id="resultsModalLabel">
                    <i class="bi bi-heart-pulse-fill text-success"></i> نتيجة التحليل الطبي
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body p-4 bg-light" id="modalResultsBody">
                <!-- AJAX loaded content will go here -->
            </div>
            <div class="modal-footer border-0 bg-white p-3 justify-content-center">
                <span class="text-muted small fw-semibold"><i class="bi bi-shield-fill-check text-success"></i> بوابة المرضى الآمنة — معمل أمان للتحاليل الطبية</span>
            </div>
        </div>
    </div>
</div>


<!-- ══════════════════ HOME VISIT REQUEST ══════════════════ -->
<section id="homeVisit" style="background-color: #f8f9fa; padding: 60px 0;">
    <div class="container" dir="rtl">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">
                <div class="visit-card" style="background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 40px; border: 1px solid #eef2f5;">
                    <div class="visit-header text-center mb-4">
                        <i class="bi bi-house-heart" style="font-size: 3.5rem; color: #d5212a; margin-bottom: 10px; display: block;"></i>
                        <h2 style="font-weight: 800; color: #7f1d1d; font-size: 1.8rem;">طلب زيارة منزلية</h2>
                        <p style="color: #64748b; font-size: 0.95rem;">احجز زيارة منزلية لسحب العينات بكل سهولة وأمان</p>
                    </div>
                    
                    <form id="homeVisitForm" novalidate>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label for="userName" class="form-label" style="font-weight: 700; color: #2c3e50; font-size: 0.95rem;">الاسم رباعي <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="userName" placeholder="أدخل اسمك بالكامل" required style="border-radius: 12px; padding: 14px 15px; font-size: 1rem; border: 1px solid #dee2e6;">
                                <div class="invalid-feedback" style="font-size: 0.85rem; font-weight: 600;">الرجاء إدخال الاسم.</div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label for="userPhone" class="form-label" style="font-weight: 700; color: #2c3e50; font-size: 0.95rem;">رقم الهاتف <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" id="userPhone" placeholder="01xxxxxxxxx" dir="ltr" style="text-align:right; border-radius: 12px; padding: 14px 15px; font-size: 1rem; border: 1px solid #dee2e6;" required>
                                <div class="invalid-feedback" style="font-size: 0.85rem; font-weight: 600;">الرجاء إدخال رقم هاتف صحيح.</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="userAddress" class="form-label" style="font-weight: 700; color: #2c3e50; font-size: 0.95rem;">العنوان بالتفصيل <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="userAddress" rows="3" placeholder="أدخل عنوانك بالتفصيل" required style="border-radius: 12px; padding: 14px 15px; font-size: 1rem; border: 1px solid #dee2e6;"></textarea>
                            <div class="invalid-feedback" style="font-size: 0.85rem; font-weight: 600;">الرجاء إدخال العنوان بالتفصيل.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" style="font-weight: 700; color: #2c3e50; font-size: 0.95rem;">صورة التحليل المطلوبة أو الروشتة (اختياري)</label>
                            <div class="file-upload-wrapper" style="position: relative;">
                                <input type="file" id="userImage" class="file-upload-input" accept="image/png, image/jpeg, image/jpg" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 2; top: 0; left: 0;">
                                <div class="file-upload-display" style="background: #fff; border: 2px dashed #ced4da; border-radius: 12px; padding: 25px 20px; text-align: center; transition: all 0.3s ease; cursor: pointer;">
                                    <i class="bi bi-cloud-arrow-up" style="font-size: 2.5rem; color: #d5212a; margin-bottom: 10px; display: block;"></i>
                                    <div style="font-weight: 700; color: #2c3e50;">اضغط هنا لاختيار صورة</div>
                                    <small class="text-muted">JPG, PNG (الحد الأقصى 5 ميجابايت)</small>
                                </div>
                            </div>
                            <div id="imagePreviewContainer" style="display: none; margin-top: 15px; border-radius: 12px; overflow: hidden; border: 2px dashed #d5212a; text-align: center; padding: 10px; background: #f8f9fa;">
                                <img id="imagePreview" src="#" alt="Preview" style="max-width: 100%; max-height: 250px; border-radius: 8px; object-fit: contain;">
                            </div>
                        </div>

                        <div class="alert alert-info text-center" role="alert" style="border-radius: 12px; font-weight: 600;">
                            <i class="bi bi-info-circle-fill me-2"></i> سيتم تأكيد الطلب من خلال التواصل معكم
                        </div>

                        <button type="submit" class="btn btn-success w-100" id="submitVisitBtn" style="background: #25D366; border: none; padding: 16px; font-size: 1.15rem; font-weight: 700; border-radius: 12px; display: flex; justify-content: center; align-items: center; gap: 10px;">
                            <i class="bi bi-whatsapp"></i>
                            <span>طلب زيارة منزلية عبر واتساب</span>
                        </button>
                        
                        <div id="successVisitMsg" class="alert alert-success mt-3 text-center" style="display: none; border-radius: 12px; font-weight: 600;">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            جاري تحويلك إلى واتساب...
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════ ABOUT ══════════════════ -->
<section id="about">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="section-eyebrow">عن المعمل</span>
                <h2 class="section-title mb-4">لماذا تختار معمل أمان؟</h2>
                <p class="text-muted lh-lg mb-4">
                    معمل أمان للتحاليل الطبية هو مرفق صحي متكامل يعمل بأحدث الأجهزة والمعدّات الطبية المعتمدة عالمياً.
                    نحن نؤمن بأن دقة التحليل هي الخطوة الأولى نحو التشخيص الصحيح، لذلك نلتزم بأعلى معايير الجودة
                    وآليات ضبط الجودة الدولية في كل مرحلة من مراحل التحليل.
                </p>
                <div class="row g-3">
                    <div class="col-4">
                        <div class="about-stat">
                            <div class="num">+15</div>
                            <div class="lbl">سنة خبرة</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="about-stat">
                            <div class="num">+50k</div>
                            <div class="lbl">عميل راضٍ</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="about-stat">
                            <div class="num">+200</div>
                            <div class="lbl">نوع تحليل</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light-subtle h-100">
                            <i class="bi bi-patch-check-fill text-primary fs-3 mb-2 d-block"></i>
                            <h6 class="fw-bold mb-1">دقة عالية</h6>
                            <p class="text-muted small mb-0">نتائج موثوقة بأحدث التقنيات الطبية</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light-subtle h-100">
                            <i class="bi bi-clock-history text-success fs-3 mb-2 d-block"></i>
                            <h6 class="fw-bold mb-1">نتائج سريعة</h6>
                            <p class="text-muted small mb-0">استلام نتائجك خلال ساعات</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light-subtle h-100">
                            <i class="bi bi-shield-fill-check text-info fs-3 mb-2 d-block"></i>
                            <h6 class="fw-bold mb-1">سرية تامة</h6>
                            <p class="text-muted small mb-0">بياناتك محمية بالكامل</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-4 shadow-sm border border-light-subtle h-100">
                            <i class="bi bi-person-badge-fill text-warning fs-3 mb-2 d-block"></i>
                            <h6 class="fw-bold mb-1">فريق متخصص</h6>
                            <p class="text-muted small mb-0">أطباء وأخصائيون معتمدون</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════ SERVICES ══════════════════ -->
<section id="services" style="background:#fff">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-eyebrow">خدماتنا</span>
            <h2 class="section-title">تحاليل متنوعة بجودة عالية</h2>
            <div class="section-line mx-auto"></div>
        </div>
        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-droplet-fill"></i></div>
                    <h5>تحاليل الدم</h5>
                    <p>فحص شامل لعناصر الدم وتحديد أي اضطرابات بدقة عالية وسرعة في النتيجة.</p>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-capsule-pill"></i></div>
                    <h5>تحاليل الفيتامينات</h5>
                    <p>قياس مستويات الفيتامينات الأساسية مثل D, B12, C وغيرها للحفاظ على صحتك.</p>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <h5>تحاليل الهرمونات</h5>
                    <p>فحص الهرمونات الجنسية والغدة الدرقية وغيرها بدقة مختبرية عالية.</p>
                </div>
            </div>
            <!-- Card 4 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                    <h5>تحاليل السكر</h5>
                    <p>قياس نسبة الجلوكوز ومعدل السكر التراكمي HbA1c لمتابعة حالة السكري.</p>
                </div>
            </div>
            <!-- Card 5 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-people-fill"></i></div>
                    <h5>تحاليل ما قبل الزواج</h5>
                    <p>حزمة شاملة للكشف المبكر عن الأمراض الوراثية وضمان صحة الأسرة.</p>
                </div>
            </div>
            <!-- Card 6 -->
            <div class="col-sm-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                    <h5>وظائف الكبد والكلى</h5>
                    <p>تقييم دقيق لوظائف الكبد والكلى للكشف المبكر عن أي خلل وظيفي.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════ HOW IT WORKS ══════════════════ -->
<section id="howItWorks">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-eyebrow">كيف يعمل</span>
            <h2 class="section-title">كيفية الحصول على تحليلك</h2>
            <div class="section-line mx-auto"></div>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-sm-10 col-md-4">
                <div class="step-card pt-4">
                    <div class="step-num">1</div>
                    <div class="step-icon"><i class="bi bi-telephone-fill"></i></div>
                    <h5>أدخل رقم هاتفك</h5>
                    <p>اكتب رقم هاتفك المسجّل لدينا في خانة البحث للوصول إلى نتائجك.</p>
                </div>
            </div>
            <div class="col-sm-10 col-md-4">
                <div class="step-card pt-4">
                    <div class="step-num">2</div>
                    <div class="step-icon"><i class="bi bi-file-earmark-medical-fill"></i></div>
                    <h5>يظهر آخر تحليل</h5>
                    <p>يتم استرجاع آخر نتيجة تحليل مرتبطة برقمك بشكل فوري وآمن.</p>
                </div>
            </div>
            <div class="col-sm-10 col-md-4">
                <div class="step-card pt-4">
                    <div class="step-num">3</div>
                    <div class="step-icon"><i class="bi bi-download"></i></div>
                    <h5>تحميل أو عرض التحاليل</h5>
                    <p>يمكنك تحميل التحليل بصيغة PDF أو تصفح جميع تحاليلك السابقة بسهولة.</p>
                </div>
            </div>
        </div>
    </div>
