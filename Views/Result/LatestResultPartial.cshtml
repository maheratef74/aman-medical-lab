@model DrMohamedWeb.ViewModels.PatientResultViewModel
@{
    Layout = null;
}

<div class="result-container animate-fade-in">
    <!-- Empathetic greeting card -->
    <div class="alert border-0 rounded-4 p-4 mb-4 d-flex align-items-start gap-3 shadow-sm" style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-right: 5px solid #22c55e !important; text-align: right;">
        <div class="fs-1 text-success leading-none"><i class="bi bi-heart-pulse-fill"></i></div>
        <div>
            <h4 class="fw-black text-success mb-1" style="font-size: 1.25rem;">ألف سلامة عليك يا @Model.PatientName 👋</h4>
            <p class="mb-0 text-success-emphasis opacity-90 fw-bold" style="font-size: 0.9rem; line-height: 1.6;">
                معمل أمان يتمنى لك الشفاء العاجل ودوام الصحة والعافية. نتائج تحاليلك جاهزة ومحمية بأمان أدناه.
            </p>
        </div>
    </div>

    <!-- Patient Info Summary Card -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
        <div class="card-body p-4 bg-white" style="text-align: right;">
            <div class="row align-items-center gy-3">
                <div class="col-sm-6">
                    <small class="text-muted d-block fw-bold mb-1">اسم المريض</small>
                    <span class="fs-5 fw-extrabold text-slate-800 d-block">@Model.PatientName</span>
                </div>
                <div class="col-sm-6 text-sm-start">
                    <small class="text-muted d-block fw-bold mb-1">رقم الهاتف</small>
                    <span class="fs-5 fw-extrabold text-slate-700 dir-ltr d-inline-block">@Model.PhoneNumber</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.LatestVisit != null)
    {
        <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
            <!-- Header for Latest Visit -->
            <div class="px-4 py-3 bg-light border-bottom border-light-subtle d-flex align-items-center justify-content-between flex-wrap gap-2" style="text-align: right;">
                <span class="fw-bold text-dark d-inline-flex align-items-center gap-2">
                    <i class="bi bi-calendar2-check text-success"></i>
                    زيارة بتاريخ: <span class="text-success fw-extrabold">@Model.LatestVisit.VisitDate.ToString("yyyy/MM/dd")</span>
                </span>
                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1.5 fw-bold text-xs">آخر زيارة</span>
            </div>

            <div class="card-body p-4 bg-white" style="text-align: right;">
                @if (!string.IsNullOrWhiteSpace(Model.LatestVisit.Notes))
                {
                    <div class="p-3 rounded-3 bg-light border-0 mb-4 text-slate-600 font-semibold" style="font-size: 0.9rem; border-right: 4px solid #cbd5e1 !important;">
                        <i class="bi bi-info-circle me-1 text-slate-500"></i> ملاحظات الطبيب: @Model.LatestVisit.Notes
                    </div>
                }

                @if (Model.LatestVisit.TestResults.Any())
                {
                    <div class="space-y-3">
                        @foreach (var test in Model.LatestVisit.TestResults)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-4 bg-light border-0 hover-lift transition-all" style="border: 1px solid #f1f5f9 !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="w-10 h-10 rounded-3 bg-success-subtle text-success d-flex align-items-center justify-center fs-4 shrink-0">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <span class="fw-extrabold text-slate-800 d-block truncate" style="font-size: 0.95rem;">@test.TestName</span>
                                        <small class="text-muted fw-semibold">صيغة الملف: PDF</small>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Content("~/" + test.FilePath.TrimStart('/'))" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                                        <i class="bi bi-eye-fill me-1"></i> عرض
                                    </a>
                                    <a asp-action="Download" asp-controller="Result" asp-route-id="@test.Id" class="btn btn-success btn-sm rounded-pill px-3 fw-bold" style="background-color: #198754; border-color: #198754;">
                                        <i class="bi bi-download me-1"></i> تحميل
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-file-earmark-x fs-2 d-block mb-2 text-slate-300"></i>
                        <span class="fw-bold" style="font-size: 0.95rem;">لم يتم رفع ملف النتيجة لهذه الزيارة بعد</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- View previous visits button -->
    <button type="button" id="loadAllVisitsBtn" data-phone="@Model.PhoneNumber" class="btn btn-outline-success w-100 rounded-4 py-3 fw-bold text-center border-2 d-flex align-items-center justify-content-center gap-2 hover:bg-success hover:text-white transition-all" style="color: #198754; border-color: #198754;">
        <i class="bi bi-clock-history"></i>
        <span>عرض جميع الزيارات السابقة للمريض</span>
    </button>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15,23,42,.05);
        background-color: #fdfdfd !important;
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
