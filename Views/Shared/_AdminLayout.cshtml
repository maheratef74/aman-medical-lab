<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — معمل أمان</title>
    <link rel="icon" type="image/png" href="~/images/aman-logo.png" />
    
    <!-- PWA Settings -->
    <link rel="manifest" href="~/admin-manifest.webmanifest" />
    <meta name="theme-color" content="#d5212a" />
    <link rel="apple-touch-icon" href="~/icons/icon-180.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="إدارة أمان" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ["'Cairo'", 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50:  '#fef2f2',
                            100: '#fde8e8',
                            200: '#fcd4d4',
                            300: '#f9a8a8',
                            400: '#f47171',
                            500: '#ea4444',
                            600: '#d5212a',
                            700: '#b91c2c',
                            800: '#991b1b',
                            900: '#7f1d1d',
                        },
                    },
                    boxShadow: {
                        'card': '0 1px 3px rgba(15,23,42,.06), 0 4px 16px rgba(15,23,42,.06)',
                        'card-hover': '0 4px 8px rgba(15,23,42,.08), 0 12px 28px rgba(15,23,42,.10)',
                        'sidebar': '2px 0 16px rgba(15,23,42,.10)',
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts — Cairo (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <style>
        * { font-family: 'Cairo', sans-serif; }

        /* Sidebar transition & RTL positioning */
        #admin-sidebar {
            transition: transform 0.3s cubic-bezier(.4,0,.2,1);
        }
        #main-wrapper {
            transition: margin-right 0.3s cubic-bezier(.4,0,.2,1);
        }

        /* Desktop rules (>= 1024px) */
        @@media (min-width: 1024px) {
            #admin-sidebar {
                transform: translateX(0);
            }
            .sidebar-collapsed #admin-sidebar {
                transform: translateX(100%) !important;
            }
            .sidebar-collapsed #main-wrapper {
                margin-right: 0 !important;
            }
        }

        /* Mobile rules (< 1024px) */
        @@media (max-width: 1023.98px) {
            #admin-sidebar {
                transform: translateX(100%);
            }
            #admin-sidebar.sidebar-mobile-open {
                transform: translateX(0) !important;
            }
        }

        #sidebar-overlay {
            transition: opacity 0.3s ease;
        }

        /* Active nav item */
        .nav-link-active {
            background-color: #fef2f2;
            color: #b91c2c !important;
            font-weight: 700;
        }
        .nav-link-active .nav-icon-wrap {
            background-color: #b91c2c;
            color: #fff;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Toast animation */
        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(60px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .toast-enter { animation: slideInRight 0.35s ease forwards; }

        /* Page enter */
        @@keyframes pageFadeUp {
            from { opacity: 0; }
            to   { opacity: 1; }
        }
        .page-content { animation: pageFadeUp 0.3s ease forwards; }

        /* Table rows */
        tbody tr { transition: background-color 0.15s; }

        /* Form focus ring */
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #d5212a !important;
            box-shadow: 0 0 0 3px rgba(213,33,42,.12);
        }

        /* Progress bar stripe */
        @@keyframes stripeMove {
            from { background-position: 0 0; }
            to   { background-position: 40px 0; }
        }
        .progress-stripe {
            background-image: linear-gradient(
                45deg,
                rgba(255,255,255,.15) 25%,
                transparent 25%,
                transparent 50%,
                rgba(255,255,255,.15) 50%,
                rgba(255,255,255,.15) 75%,
                transparent 75%
            );
            background-size: 40px 40px;
            animation: stripeMove 1s linear infinite;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

    <!-- ═══════════════════════════════════════
         MOBILE OVERLAY
    ═══════════════════════════════════════ -->
    <div id="sidebar-overlay"
         class="fixed inset-0 bg-slate-900/50 z-30 opacity-0 pointer-events-none lg:hidden"
         onclick="closeSidebar()">
    </div>

    <!-- ═══════════════════════════════════════
         SIDEBAR
    ═══════════════════════════════════════ -->
    <aside id="admin-sidebar"
           class="fixed top-0 right-0 h-full w-64 bg-white border-l border-slate-100 shadow-sidebar z-40 flex flex-col">

        <!-- Logo -->
        <div class="flex items-center gap-3 px-5 py-5 border-b border-slate-100">
            <img src="~/images/aman-logo.png" alt="Logo" class="w-14 h-14 object-contain shrink-0 mix-blend-multiply" />
            <div>
                <div class="font-extrabold text-base leading-tight"><span class="text-slate-900">معمل</span> <span class="text-brand-600">أمان</span></div>
                <div class="text-xs text-slate-400 font-medium">لوحة الإدارة</div>
            </div>
            <!-- Sidebar toggle close button -->
            <button onclick="toggleSidebar()"
                    title="إغلاق القائمة الجانبية"
                    class="mr-auto p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-0.5">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider px-3 mb-2">القائمة الرئيسية</p>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                bool isDashboard = currentController == "Admin" && currentAction == "Dashboard";
                bool isPatientsList = currentController == "Patients" && currentAction == "Index";
                bool isCreatePatient = currentController == "Patients" && currentAction == "Create";
                bool isVisitFlow = currentController == "Visits" && currentAction == "AddVisit";
                bool isDoctorVisits = currentController == "Visits" && currentAction == "DoctorVisits";
            }

            <a asp-controller="Admin" asp-action="Dashboard"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-all duration-150 group @(isDashboard ? "nav-link-active" : "")">
                <span class="nav-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center @(isDashboard ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200") transition-all">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                </span>
                <span class="text-sm font-semibold">لوحة التحكم</span>
            </a>

            <a asp-controller="Patients" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-all duration-150 group @(isPatientsList ? "nav-link-active" : "")">
                <span class="nav-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center @(isPatientsList ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200") transition-all">
                    <i data-lucide="users" class="w-4 h-4"></i>
                </span>
                <span class="text-sm font-semibold">المرضى</span>
            </a>


            <a asp-controller="Visits" asp-action="AddVisit"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-all duration-150 group @(isVisitFlow ? "nav-link-active" : "")">
                <span class="nav-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center @(isVisitFlow ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200") transition-all">
                    <i data-lucide="flask-conical" class="w-4 h-4"></i>
                </span>
                <span class="text-sm font-semibold">زيارة ونتائج</span>
                <span class="mr-auto text-xs font-bold bg-brand-600 text-white px-1.5 py-0.5 rounded-md">جديد</span>
            </a>

            <a asp-controller="Visits" asp-action="DoctorVisits"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-all duration-150 group @(isDoctorVisits ? "nav-link-active" : "")">
                <span class="nav-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center @(isDoctorVisits ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200") transition-all">
                    <i data-lucide="stethoscope" class="w-4 h-4"></i>
                </span>
                <span class="text-sm font-semibold">الزيارات</span>
            </a>

            <!-- Install App Button (Sidebar) -->
            <button id="sidebarInstallBtn" class="hidden items-center gap-3 px-3 py-2.5 rounded-xl text-brand-600 hover:bg-brand-50 hover:text-brand-700 transition-all duration-150 group w-full text-right mt-2">
                <span class="nav-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center bg-brand-50 border border-brand-200 text-brand-600 group-hover:bg-brand-100 transition-all">
                    <i data-lucide="monitor-smartphone" class="w-4 h-4"></i>
                </span>
                <span class="text-sm font-semibold">تثبيت التطبيق</span>
            </button>
        </nav>

        <!-- Sidebar Bottom: Logout -->
        <div class="px-3 py-4 border-t border-slate-100">
            <form asp-controller="Admin" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="flex items-center gap-3 w-full px-3 py-2.5 rounded-xl text-slate-500 hover:bg-red-50 hover:text-brand-700 transition-all duration-150 group">
                    <span class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-100 group-hover:bg-red-100 transition-all">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </span>
                    <span class="text-sm font-semibold">تسجيل الخروج</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════
         MAIN WRAPPER (offset by sidebar on desktop)
    ═══════════════════════════════════════ -->
    <div id="main-wrapper" class="lg:mr-64 min-h-screen flex flex-col">

        <!-- ═══════ TOPBAR ═══════ -->
        <header class="sticky top-0 z-20 bg-white/90 backdrop-blur-sm border-b border-slate-100">
            <div class="flex items-center gap-4 px-4 sm:px-6 h-16">

                <!-- Sidebar toggle button -->
                <button onclick="toggleSidebar()"
                        title="إغلاق / فتح القائمة الجانبية"
                        class="p-2 rounded-xl text-slate-600 hover:text-brand-600 hover:bg-slate-100 transition-colors flex items-center justify-center shrink-0">
                    <i data-lucide="panel-right-close" id="sidebar-toggle-icon" class="w-5 h-5"></i>
                </button>

                <!-- Page title + breadcrumb -->
                <div class="flex-1 min-w-0">
                    <h1 class="text-base font-bold text-slate-800 truncate">@ViewData["Title"]</h1>
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <p class="text-xs text-slate-400 mt-0.5">@ViewData["Breadcrumb"]</p>
                    }
                </div>

                <!-- Topbar actions -->
                <div class="flex items-center gap-2">
                    <!-- Notification bell -->
                    <button class="relative p-2 rounded-xl text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-brand-600 rounded-full"></span>
                    </button>

                    <!-- Divider -->
                    <div class="w-px h-6 bg-slate-200 mx-1"></div>

                    <!-- User avatar -->
                    <div class="flex items-center gap-2.5 cursor-pointer group">
                        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-600 to-brand-900 flex items-center justify-center text-white font-bold text-sm shadow-sm shadow-brand-600/30">
                            م
                        </div>
                        <div class="hidden sm:block">
                            <div class="text-sm font-bold text-slate-700 leading-tight">الإدارة</div>
                            <div class="text-xs text-slate-400">مدير النظام</div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ═══════ PAGE CONTENT ═══════ -->
        <main class="flex-1 px-4 sm:px-6 py-6 page-content" role="main">
            @RenderBody()
        </main>

        <!-- ═══════ FOOTER ═══════ -->
        <footer class="px-6 py-4 border-t border-slate-100 bg-white mt-auto">
            <p class="text-xs text-slate-400 text-center">
                © 2026 معمل أمان للتحاليل الطبية — جميع الحقوق محفوظة
            </p>
        </footer>
    </div>


    <!-- ═══════════════════════════════════════
         SCRIPTS
    ═══════════════════════════════════════ -->
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Sidebar open/close & collapse toggle
        function toggleSidebar() {
            const isMobile = window.innerWidth < 1024;
            const sidebar = document.getElementById('admin-sidebar');
            
            if (isMobile) {
                if (sidebar.classList.contains('sidebar-mobile-open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            } else {
                const body = document.body;
                const isCollapsed = body.classList.toggle('sidebar-collapsed');
                localStorage.setItem('sidebar_collapsed', isCollapsed ? 'true' : 'false');
                updateToggleIcon(isCollapsed);
            }
        }

        function updateToggleIcon(isCollapsed) {
            const icon = document.getElementById('sidebar-toggle-icon');
            if (icon) {
                icon.setAttribute('data-lucide', isCollapsed ? 'panel-right-open' : 'panel-right-close');
                lucide.createIcons();
            }
        }

        function openSidebar() {
            const sidebar = document.getElementById('admin-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.add('sidebar-mobile-open');
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.classList.add('opacity-100');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            const sidebar = document.getElementById('admin-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.remove('sidebar-mobile-open');
            overlay.classList.add('opacity-0', 'pointer-events-none');
            overlay.classList.remove('opacity-100');
            document.body.style.overflow = '';
        }

        // Apply saved sidebar preference on initial load
        (function () {
            if (window.innerWidth >= 1024 && localStorage.getItem('sidebar_collapsed') === 'true') {
                document.body.classList.add('sidebar-collapsed');
                document.addEventListener('DOMContentLoaded', () => updateToggleIcon(true));
            }
        })();

        // Toast notifications
        window.showToast = function(message, type = 'success') {
            const colors = {
                success: 'bg-green-600',
                error:   'bg-red-600',
                warning: 'bg-amber-500',
                info:    'bg-blue-600',
            };
            const icons = {
                success: 'check-circle',
                error:   'x-circle',
                warning: 'alert-triangle',
                info:    'info',
            };
            const toast = document.createElement('div');
            toast.className = `toast-enter fixed bottom-6 left-6 z-50 flex items-center gap-3 px-4 py-3 rounded-xl text-white text-sm font-semibold shadow-xl ${colors[type] || colors.success}`;
            toast.innerHTML = `<i data-lucide="${icons[type] || 'check-circle'}" class="w-4 h-4 shrink-0"></i><span>${message}</span>`;
            document.body.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(60px)'; toast.style.transition = 'all 0.3s ease'; }, 3000);
            setTimeout(() => toast.remove(), 3350);
        };

        // Re-init lucide after any dynamic content
        document.addEventListener('DOMContentLoaded', () => lucide.createIcons());

        // ══════════════════ PWA: Service Worker + Install Prompt ══════════════════
        (function () {
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js').catch(function (err) {
                        console.warn('SW registration failed:', err);
                    });
                });
            }

            const installBtn = document.getElementById('sidebarInstallBtn');
            if (!installBtn) return;
            
            let deferredPrompt = null;
            const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
            const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

            function showInstallButton() {
                installBtn.classList.remove('hidden');
                installBtn.classList.add('flex');
            }

            function hideInstallButton() {
                installBtn.classList.add('hidden');
                installBtn.classList.remove('flex');
            }

            if (isStandalone) {
                hideInstallButton();
                return;
            }

            // Always show the button for visibility
            showInstallButton();

            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                showInstallButton();
            });

            window.addEventListener('appinstalled', function () {
                hideInstallButton();
            });

            installBtn.addEventListener('click', function () {
                if (isIOS && !deferredPrompt) {
                    alert('لتثبيت التطبيق على الآيفون، اضغط على زر المشاركة (Share) في المتصفح بالأسفل ثم اختر "إضافة إلى الشاشة الرئيسية" (Add to Home Screen).');
                    return;
                }
                if (!deferredPrompt) {
                    alert('عذراً، المتصفح لم يرسل طلب التثبيت التلقائي.\n\nللتثبيت يدوياً: اضغط على أيقونة التثبيت في شريط عنوان المتصفح، أو من قائمة المتصفح (ثلاث نقاط) اختر "تثبيت التطبيق" أو "Install App".');
                    return;
                }
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(function (choice) {
                    if (choice.outcome === 'accepted') hideInstallButton();
                    deferredPrompt = null;
                });
            });
        })();

        // ══════════════════ Silent 401 JWT Refresh Interceptor ══════════════════
        (function () {
            let isRefreshing = false;
            let refreshSubscribers = [];

            function onRefreshed(success) {
                refreshSubscribers.forEach(cb => cb(success));
                refreshSubscribers = [];
            }

            async function performSilentRefresh() {
                try {
                    const response = await fetch('/Admin/RefreshToken', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({})
                    });
                    if (response.ok) {
                        const data = await response.json();
                        return data && data.success;
                    }
                } catch (e) {
                    console.error('Silent refresh failed:', e);
                }
                return false;
            }

            const originalFetch = window.fetch;
            window.fetch = async function (...args) {
                let response = await originalFetch.apply(this, args);

                if (response.status === 401 && !args[0].toString().includes('/Admin/RefreshToken') && !args[0].toString().includes('/Admin/Login')) {
                    if (!isRefreshing) {
                        isRefreshing = true;
                        const success = await performSilentRefresh();
                        isRefreshing = false;
                        onRefreshed(success);

                        if (success) {
                            return originalFetch.apply(this, args);
                        } else {
                            window.location.href = '/Admin/Login';
                            return response;
                        }
                    } else {
                        return new Promise(resolve => {
                            refreshSubscribers.push(async (success) => {
                                if (success) {
                                    resolve(await originalFetch.apply(this, args));
                                } else {
                                    window.location.href = '/Admin/Login';
                                    resolve(response);
                                }
                            });
                        });
                    }
                }

                return response;
            };
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
