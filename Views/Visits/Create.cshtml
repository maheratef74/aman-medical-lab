@model DrMohamedWeb.Core.Entities.PatientVisit

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إضافة زيارة جديدة";
    ViewData["Breadcrumb"] = "معمل أمان / المرضى / إضافة زيارة";
}

<!-- ═══════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════ -->
<div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-slate-400 mb-3">
        <a asp-controller="Patients" asp-action="Index" class="hover:text-brand-600 transition-colors">المرضى</a>
        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
        <a asp-action="Index" asp-route-patientId="@Model.PatientId" class="hover:text-brand-600 transition-colors">الزيارات</a>
        <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
        <span class="text-slate-600 font-semibold">إضافة زيارة</span>
    </div>
    <h2 class="text-2xl font-extrabold text-slate-800">إضافة زيارة جديدة</h2>
    <p class="text-sm text-slate-500 mt-1">سجل بيانات الزيارة للمريض</p>
</div>

<!-- ═══════════════════════════════════════
     FORM CARD
═══════════════════════════════════════ -->
<div class="max-w-xl">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="h-1.5 bg-gradient-to-l from-brand-600 to-brand-800"></div>

        <div class="p-6 sm:p-8">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="flex items-start gap-3 p-4 mb-6 rounded-xl bg-red-50 border border-red-200">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0 mt-0.5"></i>
                    <div asp-validation-summary="All" class="text-sm text-red-600"></div>
                </div>
            }

            <form asp-action="Create" method="post" id="createVisitForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PatientId" />

                <!-- Visit Date -->
                <div class="mb-5">
                    <label asp-for="VisitDate" class="block text-sm font-bold text-slate-700 mb-1.5">
                        <i data-lucide="calendar" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                        تاريخ الزيارة
                        <span class="text-brand-600">*</span>
                    </label>
                    <input asp-for="VisitDate"
                           type="date"
                           required
                           class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 focus:bg-white transition-colors" />
                    <span asp-validation-for="VisitDate" class="mt-1 text-xs font-semibold text-red-600"></span>
                </div>

                <!-- Notes -->
                <div class="mb-5">
                    <label asp-for="Notes" class="block text-sm font-bold text-slate-700 mb-1.5">
                        <i data-lucide="sticky-note" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                        ملاحظات الزيارة
                        <span class="text-xs font-medium text-slate-400 mr-1">(اختياري)</span>
                    </label>
                    <textarea asp-for="Notes"
                              class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors resize-none"
                              rows="4"
                              placeholder="أدخل أي ملاحظات بخصوص الزيارة أو التحاليل المطلوبة..."></textarea>
                    <span asp-validation-for="Notes" class="mt-1 text-xs font-semibold text-red-600"></span>
                </div>

                <!-- Visibility Toggle -->
                <div class="mb-7 flex items-center gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100">
                    <input asp-for="IsAvailable"
                           type="checkbox"
                           id="isAvailable"
                           class="w-5 h-5 rounded border-slate-300 text-green-600 focus:ring-green-600 cursor-pointer" />
                    <label for="isAvailable" class="flex-1 cursor-pointer">
                        <span class="block text-sm font-bold text-slate-700">متاحة للمريض</span>
                        <span class="block text-xs font-medium text-slate-400 mt-0.5">تظهر في الموقع عند البحث برقم الهاتف</span>
                    </label>
                    <i data-lucide="eye" class="w-4 h-4 text-green-600"></i>
                </div>

                <!-- Buttons -->
                <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3">
                    <a asp-action="Index" asp-route-patientId="@Model.PatientId"
                       class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        إلغاء والعودة
                    </a>
                    <button type="submit"
                            id="submitVisitBtn"
                            class="flex items-center justify-center gap-2 flex-1 sm:flex-initial px-6 py-2.5 rounded-xl bg-green-600 text-white text-sm font-bold shadow-lg shadow-green-600/25 hover:bg-green-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        تسجيل الزيارة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();
    document.getElementById('createVisitForm').addEventListener('submit', function() {
        var btn = document.getElementById('submitVisitBtn');
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> جاري الحفظ…';
    });
</script>
}
