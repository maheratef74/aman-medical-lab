@model DrMohamedWeb.ViewModels.AddVisitViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إضافة مريض / زيارة ونتائج";
    ViewData["Breadcrumb"] = "معمل أمان / إضافة زيارة ونتائج";
}

<!-- ═══════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════ -->
<div class="mb-6">
    <h2 class="text-2xl font-extrabold text-slate-800">إضافة مريض / زيارة ونتائج</h2>
    <p class="text-slate-500 text-sm mt-1">ثلاث خطوات بسيطة تفصلك عن تسجيل زيارة كاملة — حتى للمرضى الجدد</p>
</div>

<!-- Validation summary -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="flex items-start gap-3 p-4 mb-6 rounded-xl bg-red-50 border border-red-200 max-w-2xl mx-auto">
        <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 shrink-0 mt-0.5"></i>
        <div>
            <p class="text-sm font-bold text-red-700 mb-1">يوجد أخطاء في البيانات:</p>
            <div asp-validation-summary="All" class="text-sm text-red-600 space-y-0.5"></div>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════
     WIZARD CARD
═══════════════════════════════════════ -->
<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">

        <!-- Card top accent -->
        <div class="h-1.5 bg-gradient-to-l from-brand-600 to-brand-800"></div>

        <div class="p-6 sm:p-8">

            <!-- ─── STEPPER ─── -->
            <div class="flex items-center justify-center gap-0 mb-6">

                <!-- Step 1 -->
                <div class="flex flex-col items-center" id="step-indicator-1">
                    <div id="step-circle-1"
                         class="w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-brand-600 bg-brand-600 text-white shadow-lg shadow-brand-600/30 transition-all duration-300">
                        1
                    </div>
                    <span id="step-label-1" class="text-xs font-bold text-brand-600 mt-2 whitespace-nowrap">المريض</span>
                </div>

                <!-- Connector 1-2 -->
                <div class="flex-1 mx-2">
                    <div class="h-0.5 bg-slate-200 rounded-full relative overflow-hidden">
                        <div id="connector-1" class="absolute inset-y-0 right-0 w-0 bg-green-500 rounded-full transition-all duration-500"></div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="flex flex-col items-center" id="step-indicator-2">
                    <div id="step-circle-2"
                         class="w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-slate-200 bg-white text-slate-400 transition-all duration-300">
                        2
                    </div>
                    <span id="step-label-2" class="text-xs font-bold text-slate-400 mt-2 whitespace-nowrap">بيانات الزيارة</span>
                </div>

                <!-- Connector 2-3 -->
                <div class="flex-1 mx-2">
                    <div class="h-0.5 bg-slate-200 rounded-full relative overflow-hidden">
                        <div id="connector-2" class="absolute inset-y-0 right-0 w-0 bg-green-500 rounded-full transition-all duration-500"></div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="flex flex-col items-center" id="step-indicator-3">
                    <div id="step-circle-3"
                         class="w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-slate-200 bg-white text-slate-400 transition-all duration-300">
                        3
                    </div>
                    <span id="step-label-3" class="text-xs font-bold text-slate-400 mt-2 whitespace-nowrap">النتائج والملفات</span>
                </div>
            </div>

            <!-- Progress bar -->
            <div class="h-1.5 bg-slate-100 rounded-full mb-2 overflow-hidden">
                <div id="wizardProgress"
                     class="h-full bg-gradient-to-l from-brand-600 to-brand-700 rounded-full progress-stripe transition-all duration-500"
                     style="width: 33.33%"></div>
            </div>

            <!-- Step hint -->
            <p id="stepHint" class="text-center text-xs font-semibold text-slate-400 mb-6">
                الخطوة 1 من 3: حدد المريض — اكتب رقم الهاتف أو سجل مريضاً جديداً
            </p>

            <!-- ─── FORM ─── -->
            <form asp-action="AddVisit" method="post" enctype="multipart/form-data" id="wizardForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- ══ STEP 1: PATIENT ══ -->
                <div class="step-panel" data-step-panel="1">
                    <label class="block text-sm font-bold text-slate-700 mb-1.5">
                        <i data-lucide="phone" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                        رقم الهاتف
                        <span class="text-brand-600">*</span>
                    </label>

                    <div class="relative" id="phone-autocomplete-wrap">
                        <input asp-for="PhoneNumber"
                               class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors"
                               dir="ltr"
                               id="phoneNumberInput"
                               placeholder="01xxxxxxxxx"
                               autocomplete="off"
                               style="text-align: right;" />

                        <!-- Search spinner -->
                        <span id="searchSpinner"
                              class="absolute inset-y-0 left-0 flex items-center pl-3.5 hidden">
                            <svg class="animate-spin w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </span>

                        <!-- Autocomplete dropdown -->
                        <div id="autocomplete-list"
                             class="absolute top-full right-0 left-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-50 overflow-hidden hidden max-h-52 overflow-y-auto">
                        </div>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="mt-1 text-xs font-semibold text-red-600 flex items-center gap-1"></span>

                    <!-- Patient found chip -->
                    <div id="patientFoundChip"
                         class="hidden mt-3 flex items-center gap-3 px-4 py-3 rounded-xl border border-green-200 bg-green-50 text-green-800">
                        <i data-lucide="check-circle" class="w-5 h-5 text-green-600 shrink-0"></i>
                        <div>
                            <div class="text-sm font-bold" id="foundPatientName">مريض مسجل</div>
                            <div class="text-xs text-green-600 font-medium mt-0.5">سيتم إضافة الزيارة لهذا المريض مباشرة</div>
                        </div>
                    </div>

                    <!-- New patient toggle -->
                    <div class="mt-4 flex items-center gap-3">
                        <button type="button"
                                id="isNewPatientSwitch"
                                role="switch"
                                aria-checked="false"
                                class="relative w-11 h-6 rounded-full bg-slate-200 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:ring-offset-2"
                                onclick="toggleNewPatient(this)">
                            <span class="absolute top-0.5 right-0.5 w-5 h-5 rounded-full bg-white shadow transition-transform duration-200 translate-x-0"></span>
                        </button>
                        <label class="text-sm font-bold text-slate-700 cursor-pointer" onclick="document.getElementById('isNewPatientSwitch').click()">
                            <i data-lucide="user-plus" class="w-4 h-4 inline ml-1 text-green-600"></i>
                            مريض جديد؟ أدخل اسمه وستتم إضافته تلقائياً
                        </label>
                    </div>
                    <!-- Hidden checkbox for form binding -->
                    <input type="hidden" id="isNewPatientHidden" name="IsNewPatient" value="false" />

                    <!-- New patient name field -->
                    <div id="newPatientWrap" class="hidden mt-4">
                        <label asp-for="PatientName" class="block text-sm font-bold text-slate-700 mb-1.5">
                            اسم المريض رباعي
                            <span class="text-brand-600">*</span>
                        </label>
                        <input asp-for="PatientName"
                               class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors"
                               id="patientNameInput"
                               placeholder="أدخل الاسم بالكامل" />
                        <span asp-validation-for="PatientName" class="mt-1 text-xs font-semibold text-red-600"></span>
                    </div>
                </div>

                <!-- ══ STEP 2: VISIT DATA ══ -->
                <div class="step-panel hidden" data-step-panel="2">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label asp-for="VisitDate" class="block text-sm font-bold text-slate-700 mb-1.5">
                                <i data-lucide="calendar" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                                تاريخ الزيارة
                                <span class="text-brand-600">*</span>
                            </label>
                            <input asp-for="VisitDate"
                                   type="date"
                                   class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 focus:bg-white transition-colors"
                                   id="visitDateInput" />
                            <span asp-validation-for="VisitDate" class="mt-1 text-xs font-semibold text-red-600"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <i data-lucide="eye" class="w-3.5 h-3.5 inline ml-1 text-green-600"></i>
                                ظهور النتيجة للمريض
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input asp-for="IsAvailable"
                                       type="checkbox"
                                       role="switch"
                                       id="isAvailableSwitch"
                                       checked
                                       class="w-11 h-6 appearance-none rounded-full bg-slate-200 checked:bg-green-600 transition-colors cursor-pointer relative
                                              before:content-[''] before:absolute before:top-0.5 before:right-0.5 before:w-5 before:h-5 before:rounded-full before:bg-white before:shadow before:transition-transform
                                              checked:before:translate-x-[-20px]" />
                                <span class="text-sm font-semibold text-slate-700">متاحة في الموقع (بحث برقم الهاتف)</span>
                            </label>
                        </div>
                    </div>

                    <div class="mt-5">
                        <label asp-for="Notes" class="block text-sm font-bold text-slate-700 mb-1.5">
                            <i data-lucide="sticky-note" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                            ملاحظات الزيارة
                        </label>
                        <textarea asp-for="Notes"
                                  class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors resize-none"
                                  id="notesInput"
                                  rows="4"
                                  placeholder="تحاليل مطلوبة، ملاحظات على الحالة، أو أي تفاصيل مساعدة..."></textarea>
                        <span asp-validation-for="Notes" class="mt-1 text-xs font-semibold text-red-600"></span>
                    </div>
                </div>

                <!-- ══ STEP 3: FILES ══ -->
                <div class="step-panel hidden" data-step-panel="3">
                    <div class="mb-5">
                        <label asp-for="TestName" class="block text-sm font-bold text-slate-700 mb-1.5">
                            <i data-lucide="flask-conical" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                            اسم التحليل
                        </label>
                        <input asp-for="TestName"
                               class="w-full px-4 py-3 text-sm border border-slate-200 rounded-xl bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white transition-colors"
                               id="testNameInput"
                               placeholder="مثال: صورة دم كاملة CBC، فيتامين د، وظائف كبد..." />
                        <p class="mt-1.5 text-xs text-slate-400 font-medium">
                            <i data-lucide="info" class="w-3 h-3 inline mr-0.5"></i>
                            اختياري — إذا تركته فارغاً سيُستخدم اسم الملف المرفوع
                        </p>
                        <span asp-validation-for="TestName" class="mt-1 text-xs font-semibold text-red-600"></span>
                    </div>

                    <!-- Drop zone -->
                    <label class="block text-sm font-bold text-slate-700 mb-2">
                        <i data-lucide="file-text" class="w-3.5 h-3.5 inline ml-1 text-brand-600"></i>
                        ملفات النتائج (PDF)
                    </label>
                    <div id="dropZone"
                         class="border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center cursor-pointer transition-all duration-200 hover:border-brand-400 hover:bg-brand-50/50 bg-slate-50">
                        <input type="file" id="fileInput" name="Files" class="hidden" multiple accept=".pdf" />
                        <div class="w-14 h-14 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-3">
                            <i data-lucide="upload-cloud" class="w-7 h-7 text-brand-600"></i>
                        </div>
                        <div class="text-sm font-bold text-slate-700 mb-1">اضغط هنا أو اسحب ملفات PDF وأفلتها</div>
                        <div class="text-xs text-slate-400 font-medium">يمكن إضافة أكثر من ملف — هذه الخطوة اختيارية</div>
                    </div>
                    <span asp-validation-for="Files" class="mt-1 text-xs font-semibold text-red-600"></span>

                    <!-- File chips -->
                    <div id="fileChips" class="mt-3 flex flex-col gap-2"></div>
                </div>

                <!-- ─── NAV BUTTONS ─── -->
                <div class="flex items-center justify-between mt-7 pt-5 border-t border-slate-100">
                    <button type="button"
                            id="prevBtn"
                            class="hidden items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        السابق
                    </button>

                    <div class="flex items-center gap-3 mr-auto">
                        <a asp-controller="Admin" asp-action="Dashboard"
                           class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-bold hover:bg-slate-50 transition-colors">
                            إلغاء
                        </a>
                        <button type="button"
                                id="nextBtn"
                                class="flex items-center gap-2 px-6 py-2.5 rounded-xl bg-brand-600 text-white text-sm font-bold shadow-lg shadow-brand-600/25 hover:bg-brand-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                            التالي
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        </button>
                        <button type="submit"
                                id="submitBtn"
                                class="hidden items-center gap-2 px-6 py-2.5 rounded-xl bg-green-600 text-white text-sm font-bold shadow-lg shadow-green-600/25 hover:bg-green-700 hover:-translate-y-0.5 active:translate-y-0 transition-all">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            حفظ الكل
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var currentStep = 1;
        var MAX_STEP = 3;
        var phoneInput          = document.getElementById('phoneNumberInput');
        var searchSpinner       = document.getElementById('searchSpinner');
        var isNewPatientSwitch  = document.getElementById('isNewPatientSwitch');
        var isNewPatientHidden  = document.getElementById('isNewPatientHidden');
        var newPatientWrap      = document.getElementById('newPatientWrap');
        var patientNameInput    = document.getElementById('patientNameInput');
        var patientFoundChip    = document.getElementById('patientFoundChip');
        var foundPatientName    = document.getElementById('foundPatientName');
        var dropZone            = document.getElementById('dropZone');
        var fileInput           = document.getElementById('fileInput');
        var fileChips           = document.getElementById('fileChips');
        var nextBtn             = document.getElementById('nextBtn');
        var prevBtn             = document.getElementById('prevBtn');
        var submitBtn           = document.getElementById('submitBtn');
        var progressBar         = document.getElementById('wizardProgress');
        var stepHintEl          = document.getElementById('stepHint');
        var dataTransfer        = new DataTransfer();
        var searchTimeout;
        var isNewPatientEnabled = false;

        // ── Toggle new patient (custom switch) ──
        window.toggleNewPatient = function(btn) {
            isNewPatientEnabled = !isNewPatientEnabled;
            btn.setAttribute('aria-checked', isNewPatientEnabled.toString());
            isNewPatientHidden.value = isNewPatientEnabled.toString();

            if (isNewPatientEnabled) {
                btn.classList.replace('bg-slate-200', 'bg-green-500');
                btn.querySelector('span').style.transform = 'translateX(-20px)';
                newPatientWrap.classList.remove('hidden');
                patientNameInput.required = true;
            } else {
                btn.classList.replace('bg-green-500', 'bg-slate-200');
                btn.querySelector('span').style.transform = 'translateX(0)';
                newPatientWrap.classList.add('hidden');
                patientNameInput.required = false;
            }
            hideFoundChip();
        };

        function autocompleteEl() { return document.getElementById('autocomplete-list'); }

        function showStep(n) {
            currentStep = n;

            // Panels
            document.querySelectorAll('[data-step-panel]').forEach(function (p) {
                p.classList.add('hidden');
            });
            var target = document.querySelector('[data-step-panel="' + n + '"]');
            if (target) target.classList.remove('hidden');

            // Step circles styling
            for (var i = 1; i <= MAX_STEP; i++) {
                var circle = document.getElementById('step-circle-' + i);
                var label  = document.getElementById('step-label-' + i);
                if (i < n) {
                    // done
                    circle.className = 'w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-green-500 bg-green-500 text-white shadow-md transition-all duration-300';
                    circle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
                    label.className  = 'text-xs font-bold text-green-600 mt-2 whitespace-nowrap';
                } else if (i === n) {
                    // active
                    circle.className = 'w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-brand-600 bg-brand-600 text-white shadow-lg shadow-brand-600/30 transition-all duration-300';
                    circle.innerHTML = i;
                    label.className  = 'text-xs font-bold text-brand-600 mt-2 whitespace-nowrap';
                } else {
                    // upcoming
                    circle.className = 'w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm border-2 border-slate-200 bg-white text-slate-400 transition-all duration-300';
                    circle.innerHTML = i;
                    label.className  = 'text-xs font-bold text-slate-400 mt-2 whitespace-nowrap';
                }

                // Connectors
                var connector = document.getElementById('connector-' + i);
                if (connector) {
                    connector.style.width = i < n ? '100%' : '0%';
                }
            }

            // Progress bar
            progressBar.style.width = (n / MAX_STEP * 100) + '%';

            // Nav buttons
            prevBtn.style.display  = n === 1       ? 'none'         : 'inline-flex';
            nextBtn.style.display  = n === MAX_STEP ? 'none'         : 'flex';
            submitBtn.style.display= n === MAX_STEP ? 'inline-flex'  : 'none';

            // Hint
            var hints = [
                'الخطوة 1 من 3: حدد المريض — اكتب رقم الهاتف أو سجل مريضاً جديداً',
                'الخطوة 2 من 3: بيانات الزيارة',
                'الخطوة 3 من 3: التحليل ورفع النتائج (اختياري)',
            ];
            stepHintEl.textContent = hints[n - 1];
        }

        function hideFoundChip() {
            patientFoundChip.classList.add('hidden');
            foundPatientName.textContent = '';
        }

        // ── Validation per step ──
        function validateStep(n) {
            if (n === 1) {
                if (!phoneInput.value.trim()) {
                    showWizardToast('يرجى إدخال رقم الهاتف أولاً', 'error');
                    phoneInput.focus(); return false;
                }
                if (phoneInput.value.trim().length < 10) {
                    showWizardToast('رقم الهاتف يبدو غير مكتمل', 'error');
                    phoneInput.focus(); return false;
                }
                if (isNewPatientEnabled && !patientNameInput.value.trim()) {
                    showWizardToast('أدخل اسم المريض الجديد', 'error');
                    patientNameInput.focus(); return false;
                }
                return true;
            }
            if (n === 2) {
                var d = document.getElementById('visitDateInput');
                if (d && !d.value) {
                    showWizardToast('اختر تاريخ الزيارة', 'error');
                    d.focus(); return false;
                }
                return true;
            }
            return true; // step 3 — files optional
        }

        function showWizardToast(msg, type) {
            if (window.showToast) { showToast(msg, type); return; }
            alert(msg);
        }

        nextBtn.addEventListener('click', function () {
            if (validateStep(currentStep)) showStep(currentStep + 1);
        });
        prevBtn.addEventListener('click', function () {
            if (currentStep > 1) showStep(currentStep - 1);
        });

        // ── Autocomplete ──
        phoneInput.addEventListener('input', function () {
            var phone = this.value.trim();
            var list = autocompleteEl();
            list.innerHTML = '';
            hideFoundChip();
            if (!phone) { searchSpinner.classList.add('hidden'); return; }

            clearTimeout(searchTimeout);
            searchSpinner.classList.remove('hidden');
            searchTimeout = setTimeout(function () {
                fetch('@Url.Action("SearchByPhone", "Patients")?phone=' + encodeURIComponent(phone))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        searchSpinner.classList.add('hidden');
                        list.innerHTML = '';
                        if (data.success && data.patients && data.patients.length > 0) {
                            data.patients.slice(0, 6).forEach(function (p) {
                                var item = document.createElement('div');
                                item.className = 'flex items-center gap-3 px-4 py-3 hover:bg-brand-50 cursor-pointer border-b border-slate-100 last:border-0 transition-colors';
                                item.innerHTML =
                                    '<div class="w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 font-bold text-xs shrink-0">' + (p.name ? p.name[0] : '?') + '</div>' +
                                    '<div class="flex-1 min-w-0"><div class="text-sm font-bold text-slate-800 truncate">' + p.name + '</div><div class="text-xs text-slate-400 font-mono" dir="ltr">' + p.phone + '</div></div>';
                                item.addEventListener('click', function () {
                                    phoneInput.value = p.phone;
                                    list.classList.add('hidden');
                                    patientFoundChip.classList.remove('hidden');
                                    foundPatientName.textContent = p.name;
                                    if (isNewPatientEnabled) {
                                        document.getElementById('isNewPatientSwitch').click();
                                    }
                                    lucide.createIcons();
                                });
                                list.appendChild(item);
                            });
                            list.classList.remove('hidden');
                        }
                    })
                    .catch(function () { searchSpinner.classList.add('hidden'); });
            }, 300);
        });

        // ── Dropzone ──
        dropZone.addEventListener('click', function () { fileInput.click(); });
        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropZone.classList.add('border-brand-400', 'bg-brand-50');
        });
        dropZone.addEventListener('dragleave', function () {
            dropZone.classList.remove('border-brand-400', 'bg-brand-50');
        });
        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropZone.classList.remove('border-brand-400', 'bg-brand-50');
            addFiles(e.dataTransfer.files);
        });
        fileInput.addEventListener('change', function () { addFiles(this.files); this.value = ''; });

        function addFiles(fileList) {
            Array.from(fileList).forEach(function (file) {
                if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                    showWizardToast('الملف "' + file.name + '" ليس PDF — تم تجاهله', 'error');
                    return;
                }
                dataTransfer.items.add(file);
            });
            renderChips();
        }

        function renderChips() {
            fileChips.innerHTML = '';
            var files = dataTransfer.files;
            for (var i = 0; i < files.length; i++) {
                (function (file, idx) {
                    var chip = document.createElement('div');
                    chip.className = 'flex items-center gap-3 bg-white border border-slate-200 rounded-xl px-4 py-3 shadow-sm';
                    var size = file.size > 1048576 ? (file.size / 1048576).toFixed(1) + ' MB' : Math.round(file.size / 1024) + ' KB';
                    chip.innerHTML =
                        '<div class="w-9 h-9 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 shrink-0">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>' +
                        '</div>' +
                        '<div class="flex-1 min-w-0">' +
                        '<div class="text-sm font-bold text-slate-700 truncate" dir="ltr" style="text-align:right">' + file.name + '</div>' +
                        '<div class="text-xs text-slate-400 font-medium mt-0.5">' + size + '</div>' +
                        '</div>' +
                        '<button type="button" class="w-7 h-7 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 flex items-center justify-center transition-colors shrink-0 fc-remove" title="إزالة">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>' +
                        '</button>';

                    chip.querySelector('.fc-remove').addEventListener('click', function () {
                        dataTransfer.items.remove(idx);
                        renderChips();
                    });
                    fileChips.appendChild(chip);
                })(files[i], i);
            }
            if (files.length > 0) fileInput.files = dataTransfer.files;
        }

        // ── Submit ──
        document.getElementById('wizardForm').addEventListener('submit', function (e) {
            if (!validateStep(currentStep)) { e.preventDefault(); return; }
            submitBtn.disabled = true;
            submitBtn.innerHTML =
                '<svg class="animate-spin w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">' +
                '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
                '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>' +
                '</svg>جاري الحفظ…';
        });

        // Close autocomplete on outside click
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#phone-autocomplete-wrap')) {
                var list = autocompleteEl();
                if (list) list.classList.add('hidden');
            }
        });

        // Initialize — step 1 active
        showStep(1);
        lucide.createIcons();
    })();
    </script>
}